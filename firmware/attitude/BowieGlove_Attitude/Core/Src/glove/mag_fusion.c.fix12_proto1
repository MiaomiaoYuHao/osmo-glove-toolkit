/*
 * mag_fusion.c   - see mag_fusion.h for the design notes.
 *
 * No HAL, no Bosch API, no dynamic allocation, single precision only.
 */

#include <math.h>
#include <string.h>

#include "mag_fusion.h"

#define MF_PI       3.14159265358979323846f
#define MF_TWO_PI   6.28318530717958647692f
#define MF_DEG2RAD  0.01745329251994329577f

/* BHY2 FIFO timestamps count 15625 ns ticks. */
#define MF_TICK_S   1.5625e-5f

static void mf_partial_reset(mag_fusion_t *f);

/* ======================================================================== */
/*  Scalar / quaternion helpers                                             */
/* ======================================================================== */

static float mf_wrap_pi(float a)
{
    if (!isfinite(a)) return 0.0f;
    if (a > MF_PI || a < -MF_PI)
    {
        a = fmodf(a + MF_PI, MF_TWO_PI);
        if (a < 0.0f) a += MF_TWO_PI;
        a -= MF_PI;
    }
    return a;
}

static float mf_clampf(float v, float lo, float hi)
{
    if (!(v > lo)) return lo;           /* also catches NaN */
    if (v > hi)    return hi;
    return v;
}

static float mf_maxf(float a, float b) { return (a > b) ? a : b; }

static void mf_q_normalize(float q[4])
{
    float n = sqrtf(q[0]*q[0] + q[1]*q[1] + q[2]*q[2] + q[3]*q[3]);
    if (n > 1.0e-6f) { q[0] /= n; q[1] /= n; q[2] /= n; q[3] /= n; }
    else             { q[0] = 1.0f; q[1] = q[2] = q[3] = 0.0f; }
}

static void mf_q_multiply(const float a[4], const float b[4], float out[4])
{
    out[0] = a[0]*b[0] - a[1]*b[1] - a[2]*b[2] - a[3]*b[3];
    out[1] = a[0]*b[1] + a[1]*b[0] + a[2]*b[3] - a[3]*b[2];
    out[2] = a[0]*b[2] - a[1]*b[3] + a[2]*b[0] + a[3]*b[1];
    out[3] = a[0]*b[3] + a[1]*b[2] - a[2]*b[1] + a[3]*b[0];
}

/* out = q * v * q^-1 : body vector -> world frame */
static void mf_q_rotate(const float q[4], const float v[3], float out[3])
{
    float t0 = 2.0f * (q[2]*v[2] - q[3]*v[1]);
    float t1 = 2.0f * (q[3]*v[0] - q[1]*v[2]);
    float t2 = 2.0f * (q[1]*v[1] - q[2]*v[0]);
    out[0] = v[0] + q[0]*t0 + (q[2]*t2 - q[3]*t1);
    out[1] = v[1] + q[0]*t1 + (q[3]*t0 - q[1]*t2);
    out[2] = v[2] + q[0]*t2 + (q[1]*t1 - q[2]*t0);
}

/*
 * Angle between two unit quaternions.
 *
 * 2*acos(|dot|) loses all its precision exactly where it is used most - near
 * zero - because acos has an infinite derivative at 1.  In float32 that puts
 * a 0.02 deg floor on the result, which at 100 Hz is a 2 deg/s quantisation
 * on omega.  The half-vector form is well conditioned for small angles.
 */
static float mf_q_angle(const float a[4], const float b[4])
{
    float d = a[0]*b[0] + a[1]*b[1] + a[2]*b[2] + a[3]*b[3];
    float s = (d < 0.0f) ? -1.0f : 1.0f;
    float ex = s*b[1] - a[1], ey = s*b[2] - a[2], ez = s*b[3] - a[3];
    float ew = s*b[0] - a[0];
    float n  = sqrtf(ex*ex + ey*ey + ez*ez + ew*ew);
    if (n > 2.0f) n = 2.0f;
    return 2.0f * asinf(0.5f * n);
}

static void mf_apply_yaw_correction(const mag_fusion_t *f, float q[4])
{
    float qy[4], out[4];

    if (!f->yaw_valid) return;

    float yaw_total = f->yaw_corr + (f->yaw_blend_valid ? f->yaw_blend : 0.0f);
    qy[0] = cosf(0.5f * yaw_total);
    qy[1] = 0.0f;
    qy[2] = 0.0f;
    qy[3] = sinf(0.5f * yaw_total);
    mf_q_multiply(qy, q, out);
    mf_q_normalize(out);
    memcpy(q, out, sizeof(out));
}

/* ======================================================================== */
/*  3x3 helpers (row major)                                                 */
/* ======================================================================== */

static void mf_m3_apply(const float R[9], const float v[3], float out[3])
{
    out[0] = R[0]*v[0] + R[1]*v[1] + R[2]*v[2];
    out[1] = R[3]*v[0] + R[4]*v[1] + R[5]*v[2];
    out[2] = R[6]*v[0] + R[7]*v[1] + R[8]*v[2];
}

static void mf_m3_applyT(const float R[9], const float v[3], float out[3])
{
    out[0] = R[0]*v[0] + R[3]*v[1] + R[6]*v[2];
    out[1] = R[1]*v[0] + R[4]*v[1] + R[7]*v[2];
    out[2] = R[2]*v[0] + R[5]*v[1] + R[8]*v[2];
}

static float mf_m3_det(const float A[9])
{
    return A[0]*(A[4]*A[8] - A[5]*A[7])
         - A[1]*(A[3]*A[8] - A[5]*A[6])
         + A[2]*(A[3]*A[7] - A[4]*A[6]);
}

static uint8_t mf_m3_inv(const float A[9], float out[9])
{
    float d = mf_m3_det(A);
    float id;
    if (!isfinite(d) || fabsf(d) < 1.0e-9f) return 0;
    id = 1.0f / d;
    out[0] = (A[4]*A[8] - A[5]*A[7]) * id;
    out[1] = (A[2]*A[7] - A[1]*A[8]) * id;
    out[2] = (A[1]*A[5] - A[2]*A[4]) * id;
    out[3] = (A[5]*A[6] - A[3]*A[8]) * id;
    out[4] = (A[0]*A[8] - A[2]*A[6]) * id;
    out[5] = (A[2]*A[3] - A[0]*A[5]) * id;
    out[6] = (A[3]*A[7] - A[4]*A[6]) * id;
    out[7] = (A[1]*A[6] - A[0]*A[7]) * id;
    out[8] = (A[0]*A[4] - A[1]*A[3]) * id;
    return 1;
}

static void mf_m3_mul(const float A[9], const float B[9], float out[9])
{
    uint8_t i, j;
    for (i = 0; i < 3u; i++)
        for (j = 0; j < 3u; j++)
            out[3*i+j] = A[3*i]*B[j] + A[3*i+1]*B[3+j] + A[3*i+2]*B[6+j];
}

static void mf_m3_identity(float A[9])
{
    memset(A, 0, sizeof(float) * 9);
    A[0] = A[4] = A[8] = 1.0f;
}

/*
 * Orthogonal polar factor of C: the rotation R maximising trace(R^T C), i.e.
 * minimising sum |y_i - R x_i|^2 given C = sum y_i x_i^T (Procrustes/Kabsch).
 * Higham's iteration X <- (X + X^-T)/2 needs only a 3x3 inverse.
 */
static uint8_t mf_polar(const float C[9], float R[9])
{
    float X[9], Xi[9], nX[9];
    float fn = 0.0f, diff;
    uint8_t i, iter;

    for (i = 0; i < 9; i++)
    {
        if (!isfinite(C[i])) return 0;
        fn += C[i] * C[i];
    }
    fn = sqrtf(fn / 3.0f);
    if (!(fn > 1.0e-12f)) return 0;
    for (i = 0; i < 9; i++) X[i] = C[i] / fn;

    for (iter = 0; iter < 32u; iter++)
    {
        if (!mf_m3_inv(X, Xi)) return 0;
        nX[0] = 0.5f*(X[0] + Xi[0]); nX[1] = 0.5f*(X[1] + Xi[3]); nX[2] = 0.5f*(X[2] + Xi[6]);
        nX[3] = 0.5f*(X[3] + Xi[1]); nX[4] = 0.5f*(X[4] + Xi[4]); nX[5] = 0.5f*(X[5] + Xi[7]);
        nX[6] = 0.5f*(X[6] + Xi[2]); nX[7] = 0.5f*(X[7] + Xi[5]); nX[8] = 0.5f*(X[8] + Xi[8]);

        diff = 0.0f;
        for (i = 0; i < 9; i++) { diff += fabsf(nX[i] - X[i]); X[i] = nX[i]; }
        if (diff < 1.0e-7f) break;
    }

    if (!(mf_m3_det(X) > 0.9f)) return 0;   /* a reflection is not a mounting */

    for (i = 0; i < 3; i++)
    {
        uint8_t j;
        for (j = 0; j < 3; j++)
        {
            float d = X[3*i+0]*X[3*j+0] + X[3*i+1]*X[3*j+1] + X[3*i+2]*X[3*j+2];
            float want = (i == j) ? 1.0f : 0.0f;
            if (fabsf(d - want) > 1.0e-2f) return 0;
        }
    }

    memcpy(R, X, sizeof(float) * 9);
    return 1;
}

/* Symmetric positive-definite square root, Denman-Beavers. */
static uint8_t mf_m3_sqrt(const float A[9], float out[9])
{
    float Y[9], Z[9], Yi[9], Zi[9];
    uint8_t i, it;

    memcpy(Y, A, sizeof(Y));
    mf_m3_identity(Z);

    for (it = 0; it < 32u; it++)
    {
        float diff = 0.0f;
        if (!mf_m3_inv(Y, Yi)) return 0;
        if (!mf_m3_inv(Z, Zi)) return 0;
        for (i = 0; i < 9u; i++)
        {
            float ny = 0.5f * (Y[i] + Zi[i]);
            float nz = 0.5f * (Z[i] + Yi[i]);
            diff += fabsf(ny - Y[i]);
            Y[i] = ny; Z[i] = nz;
        }
        if (diff < 1.0e-7f) break;
    }
    for (i = 0; i < 9u; i++) if (!isfinite(Y[i])) return 0;
    memcpy(out, Y, sizeof(Y));
    return 1;
}

/* Rotation matrix of a unit quaternion, row major (body -> world). */
static void mf_q_to_m3(const float q[4], float R[9])
{
    float xx = q[1]*q[1], yy = q[2]*q[2], zz = q[3]*q[3];
    float xy = q[1]*q[2], xz = q[1]*q[3], yz = q[2]*q[3];
    float wx = q[0]*q[1], wy = q[0]*q[2], wz = q[0]*q[3];
    R[0] = 1.0f - 2.0f*(yy+zz); R[1] = 2.0f*(xy-wz);        R[2] = 2.0f*(xz+wy);
    R[3] = 2.0f*(xy+wz);        R[4] = 1.0f - 2.0f*(xx+zz); R[5] = 2.0f*(yz-wx);
    R[6] = 2.0f*(xz-wy);        R[7] = 2.0f*(yz+wx);        R[8] = 1.0f - 2.0f*(xx+yy);
}

/* Rotation angle of R relative to identity. */
static float mf_m3_angle(const float R[9])
{
    float tr = R[0] + R[4] + R[8];
    return acosf(mf_clampf(0.5f * (tr - 1.0f), -1.0f, 1.0f));
}

/* ======================================================================== */
/*  Small dense linear solver                                               */
/* ======================================================================== */

static uint8_t mf_sym(uint8_t i, uint8_t j)
{
    if (i > j) { uint8_t t = i; i = j; j = t; }
    return (uint8_t)((uint16_t)i * MF_NB - ((uint16_t)i * (i - 1u)) / 2u + (j - i));
}

/* Gauss-Jordan, partial pivoting, small ridge term.  n <= 9, A destroyed. */
static uint8_t mf_solve(float *A, float *b, float *x, uint8_t n)
{
    uint8_t i, j, k, piv;
    float trace = 0.0f;

    for (i = 0; i < n; i++) trace += fabsf(A[i * n + i]);
    if (!(trace > 0.0f) || !isfinite(trace)) return 0;
    for (i = 0; i < n; i++) A[i * n + i] += 1.0e-6f * trace / (float)n;

    for (k = 0; k < n; k++)
    {
        piv = k;
        for (i = (uint8_t)(k + 1u); i < n; i++)
            if (fabsf(A[i * n + k]) > fabsf(A[piv * n + k])) piv = i;

        if (fabsf(A[piv * n + k]) < 1.0e-12f * trace) return 0;

        if (piv != k)
        {
            for (j = 0; j < n; j++)
            { float t = A[k*n+j]; A[k*n+j] = A[piv*n+j]; A[piv*n+j] = t; }
            { float t = b[k]; b[k] = b[piv]; b[piv] = t; }
        }
        {
            float inv = 1.0f / A[k * n + k];
            for (j = 0; j < n; j++) A[k * n + j] *= inv;
            b[k] *= inv;
        }
        for (i = 0; i < n; i++)
        {
            float fct;
            if (i == k) continue;
            fct = A[i * n + k];
            if (fct == 0.0f) continue;
            for (j = 0; j < n; j++) A[i * n + j] -= fct * A[k * n + j];
            b[i] -= fct * b[k];
        }
    }

    for (i = 0; i < n; i++)
    {
        if (!isfinite(b[i])) return 0;
        x[i] = b[i];
    }
    return 1;
}

static uint8_t mf_popcount(uint32_t v)
{
    uint8_t c = 0;
    while (v) { v &= (v - 1u); c++; }
    return c;
}

/* ======================================================================== */
/*  Per-sensor calibration                                                  */
/* ======================================================================== */

static void mf_cal_zero(mag_cal_t *c)
{
    uint8_t i;
    memset(c->M, 0, sizeof(c->M));
    c->n        = 0;
    c->seen     = 0;
    c->bins     = 0;
    c->frozen   = 0;
    c->restarts = 0;
    c->set      = 0;
    c->window_s = 0.0f;
    c->next_try = MAG_CAL_SPHERE_MIN;
    c->s0       = 0.0f;
    for (i = 0; i < 3; i++)
    {
        c->c0[i]   = 0.0f;
        c->last[i] = 0.0f;
        c->lo[i]   =  1.0e30f;
        c->hi[i]   = -1.0e30f;
    }
}

static void mf_cal_init(mag_cal_t *c)
{
    memset(c, 0, sizeof(*c));
    mf_m3_identity(c->W);
    c->quality = 1.0e9f;
    c->geo_q   = 1.0e9f;
    mf_cal_zero(c);
#if MAG_CAL_AUTO
    c->active = 2u;
#endif
}

/*
 * Body-frame prefilter.
 *
 * A magnetically noisy room puts a 50/60 Hz line very close to fs/2 when the
 * magnetometer runs at 100 Hz.  At that frequency nothing downstream can
 * separate it from signal, and a sample-to-sample derivative - which the old
 * slew gate took - amplifies it by 2.  [1 2 1]/4 is an exact zero at fs/2.
 *
 * This is deliberately short: the heavy lifting is done later in the WORLD
 * frame, where a long average costs nothing because the signal is constant.
 */
static void mf_fir_body(mag_cal_t *c, const float in[3], float out[3])
{
#if MAG_BODY_FIR <= 1u
    (void)c;
    out[0] = in[0]; out[1] = in[1]; out[2] = in[2];
#else
    uint8_t i;

    if (c->fir_n < (MAG_BODY_FIR - 1u))
    {
        /* not enough history yet - pass through and prime */
        for (i = (uint8_t)(MAG_BODY_FIR - 1u); i > 1u; i--)
            memcpy(c->fir[i-1u], c->fir[i-2u], sizeof(c->fir[0]));
        memcpy(c->fir[0], in, sizeof(c->fir[0]));
        c->fir_n++;
        out[0] = in[0]; out[1] = in[1]; out[2] = in[2];
        return;
    }

#if MAG_BODY_FIR == 2u
    for (i = 0; i < 3u; i++) out[i] = 0.5f * (in[i] + c->fir[0][i]);
#else
    for (i = 0; i < 3u; i++)
        out[i] = 0.25f * (in[i] + 2.0f * c->fir[0][i] + c->fir[1][i]);
#endif
    for (i = (uint8_t)(MAG_BODY_FIR - 1u); i > 1u; i--)
        memcpy(c->fir[i-1u], c->fir[i-2u], sizeof(c->fir[0]));
    memcpy(c->fir[0], in, sizeof(c->fir[0]));
#endif
}

/*
 * Which spherical cap this sample landed in.  6 faces (dominant axis and its
 * sign) x 4 quadrants of the other two axes = 24 bins.  Counting occupied
 * bins measures whether the ellipsoid parameters are observable.  The per-axis
 * min/max span the old code used does not: one big circular sweep fills all
 * three spans while leaving half the sphere unvisited, which is exactly the
 * situation that produces an over-fitted "full" model.
 */
static uint8_t mf_cal_bin(const float d[3])
{
    uint8_t ax = 0, o1, o2, b;
    float m = fabsf(d[0]);
    if (fabsf(d[1]) > m) { m = fabsf(d[1]); ax = 1u; }
    if (fabsf(d[2]) > m) { ax = 2u; }
    o1 = (uint8_t)((ax + 1u) % 3u);
    o2 = (uint8_t)((ax + 2u) % 3u);
    b  = (uint8_t)(ax * 8u);
    if (d[ax] > 0.0f) b = (uint8_t)(b + 4u);
    if (d[o1] > 0.0f) b = (uint8_t)(b + 2u);
    if (d[o2] > 0.0f) b = (uint8_t)(b + 1u);
    return b;
}

static void mf_cal_accum(mag_cal_t *c, const float m[3], float dt)
{
    float a[MF_NB], ux, uy, uz;
    uint8_t i, j;
    float *M;

    for (i = 0; i < 3; i++)
    {
        if (m[i] < c->lo[i]) c->lo[i] = m[i];
        if (m[i] > c->hi[i]) c->hi[i] = m[i];
    }
    c->seen++;
    c->window_s += dt;

    /*
     * s0 is the MEAN MAGNITUDE of the readings, not their spread.  A board
     * sitting still has almost no spread, and sizing the problem from the
     * spread would set s0 to the noise floor - which makes the decimation
     * step below smaller than the noise, so every motionless sample gets
     * accumulated and the fit ends up determined by one attitude.
     */
    if (!c->frozen)
    {
        c->c0[0] += m[0]; c->c0[1] += m[1]; c->c0[2] += m[2];
        c->s0    += sqrtf(m[0]*m[0] + m[1]*m[1] + m[2]*m[2]);
        if (c->seen < MAG_CAL_WARMUP) return;
        {
            float inv = 1.0f / (float)c->seen;
            c->c0[0] *= inv; c->c0[1] *= inv; c->c0[2] *= inv;
            c->s0    *= inv;
            if (!(c->s0 > 1.0e-3f))
            { c->c0[0] = c->c0[1] = c->c0[2] = 0.0f; c->s0 = 0.0f; c->seen = 0; return; }
            c->frozen = 1;
        }
        return;
    }

    ux = (m[0] - c->c0[0]) / c->s0;
    uy = (m[1] - c->c0[1]) / c->s0;
    uz = (m[2] - c->c0[2]) / c->s0;

    if ((fabsf(ux) > 4.0f || fabsf(uy) > 4.0f || fabsf(uz) > 4.0f) && c->restarts < 8u)
    {
        uint8_t restarts = (uint8_t)(c->restarts + 1u);
        mf_cal_zero(c);
        c->restarts = restarts;
        return;
    }

    /* Spatial decimation: one point per patch of the sphere, so that time
     * spent motionless cannot outvote the part of the sweep carrying data. */
    if (c->n > 0u)
    {
        float dx = (m[0] - c->last[0]) / c->s0;
        float dy = (m[1] - c->last[1]) / c->s0;
        float dz = (m[2] - c->last[2]) / c->s0;
        if ((dx*dx + dy*dy + dz*dz) < (MAG_CAL_STEP * MAG_CAL_STEP)) return;
    }

    {
        float d[3];
        d[0] = ux; d[1] = uy; d[2] = uz;
        c->bins |= (1uL << mf_cal_bin(d));
    }

    a[0] = ux*ux; a[1] = uy*uy; a[2] = uz*uz;
    a[3] = ux*uy; a[4] = ux*uz; a[5] = uy*uz;
    a[6] = ux;    a[7] = uy;    a[8] = uz;    a[9] = 1.0f;

    /* Alternate samples go into two independent normal matrices so a model
     * can be fitted on one half and scored on the other.  That is the only
     * honest test of whether the extra parameters of the full ellipsoid
     * generalise or have simply memorised this particular sweep. */
    M = c->M[c->set];
    for (i = 0; i < MF_NB; i++)
        for (j = i; j < MF_NB; j++)
            M[mf_sym(i, j)] += a[i] * a[j];
#if MAG_CAL_CV
    c->set ^= 1u;
#endif

    c->last[0] = m[0]; c->last[1] = m[1]; c->last[2] = m[2];
    c->n++;
}

/* theta^T M theta - the sum of squared linearised residuals, closed form. */
static float mf_quad_sse(const float *M, const float theta[MF_NB])
{
    float s = 0.0f;
    uint8_t i, j;
    for (i = 0; i < MF_NB; i++)
    {
        s += M[mf_sym(i, i)] * theta[i] * theta[i];
        for (j = (uint8_t)(i + 1u); j < MF_NB; j++)
            s += 2.0f * M[mf_sym(i, j)] * theta[i] * theta[j];
    }
    return s;
}

static void mf_theta_of(const float qc[9], float theta[MF_NB])
{
    uint8_t i;
    theta[0] = 1.0f;
    for (i = 0; i < 9u; i++) theta[i+1u] = qc[i];
}

/* Number of accumulated samples represented by a normal matrix: the [1,1]
 * entry of the basis is exactly the count. */
static float mf_set_n(const float *M) { return M[mf_sym(9u, 9u)]; }

/*
 * Recover ellipsoid geometry from the quadric coefficients.
 *   coefficient order: y^2 z^2 xy xz yz x y z 1, x^2 fixed at 1
 */
static uint8_t mf_quad_params(const float qc[9], uint8_t model,
                              float Wout[9], float cen[3], float *r, float *kout)
{
    float Am[9], Ai[9], p[3];
    float k, det, g;
    uint8_t i;

    Am[0] = 1.0f;        Am[1] = 0.5f*qc[2]; Am[2] = 0.5f*qc[3];
    Am[3] = 0.5f*qc[2];  Am[4] = qc[0];      Am[5] = 0.5f*qc[4];
    Am[6] = 0.5f*qc[3];  Am[7] = 0.5f*qc[4]; Am[8] = qc[1];

    if (!(Am[0] > 0.0f)) return 0;
    if (!((Am[0]*Am[4] - Am[1]*Am[3]) > 0.0f)) return 0;
    det = mf_m3_det(Am);
    if (!(det > 0.0f)) return 0;

    if (!mf_m3_inv(Am, Ai)) return 0;
    for (i = 0; i < 3u; i++)
        p[i] = -0.5f * (Ai[3*i]*qc[5] + Ai[3*i+1]*qc[6] + Ai[3*i+2]*qc[7]);

    {
        float Ap[3];
        mf_m3_apply(Am, p, Ap);
        k = p[0]*Ap[0] + p[1]*Ap[1] + p[2]*Ap[2] - qc[8];
    }
    if (!(k > 0.0f) || !isfinite(k)) return 0;

    if (model == 2u)
    {
        float cross  = sqrtf(qc[2]*qc[2] + qc[3]*qc[3] + qc[4]*qc[4]);
        float dscale = 1.0f + fabsf(qc[0]) + fabsf(qc[1]);
        if (cross > MAG_CAL_MAX_CROSS * dscale) return 0;
    }

    {
        float Mn[9], S[9];
        for (i = 0; i < 9u; i++) Mn[i] = Am[i] / k;
        if (!mf_m3_sqrt(Mn, S)) return 0;
        g = mf_m3_det(S);
        if (!(g > 0.0f) || !isfinite(g)) return 0;
        g = cbrtf(g);
        if (!(g > 1.0e-9f)) return 0;
        for (i = 0; i < 9u; i++) Wout[i] = S[i] / g;
        *r = 1.0f / g;
    }

    cen[0] = p[0]; cen[1] = p[1]; cen[2] = p[2];
    if (kout) *kout = k;
    return 1;
}

/* Normalised residual of a coefficient vector against a normal matrix. */
static float mf_quad_score(const float *M, const float qc[9], float k)
{
    float theta[MF_NB], sse, n = mf_set_n(M);
    if (!(n > 0.5f) || !(k > 0.0f)) return 1.0e9f;
    mf_theta_of(qc, theta);
    sse = mf_quad_sse(M, theta);
    if (sse < 0.0f) sse = 0.0f;
    return sqrtf(sse / n) / (2.0f * k);
}

/* One fit.  model 2 = full ellipsoid, 1 = diagonal, 0 = sphere. */
static uint8_t mf_quad_solve(const float *M, uint8_t model, float qc[9])
{
    static const uint8_t col_full[9] = { 1,2,3,4,5,6,7,8,9 };
    static const uint8_t col_diag[6] = { 1,2,6,7,8,9 };
    static const uint8_t col_sph [4] = { 6,7,8,9 };
    const uint8_t *col;
    uint8_t n, i, j;
    float A[81], b[9], x[9];

    if      (model == 2u) { col = col_full; n = 9u; }
    else if (model == 1u) { col = col_diag; n = 6u; }
    else                  { col = col_sph;  n = 4u; }

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++) A[i*n+j] = M[mf_sym(col[i], col[j])];
        if (model == 0u)
            b[i] = -(M[mf_sym(col[i], 0u)] + M[mf_sym(col[i], 1u)] +
                     M[mf_sym(col[i], 2u)]);
        else
            b[i] = -M[mf_sym(col[i], 0u)];
    }
    /* Cross terms are the easiest parameters to overfit under limited
     * orientation coverage; a tiny ridge pulls them toward an axis-aligned
     * model without preventing a genuinely tilted fit. */
    if (model == 2u)
    {
        float tr = 0.0f;
        for (i = 0; i < n; i++) tr += fabsf(A[i*n+i]);
        if (tr > 0.0f) for (i = 2u; i < 5u; i++) A[i*n+i] += tr * MAG_CAL_FULL_RIDGE;
    }
    if (!mf_solve(A, b, x, n)) return 0;

    for (i = 0; i < 9u; i++) qc[i] = 0.0f;
    if (model == 2u) { for (i = 0; i < 9u; i++) qc[i] = x[i]; }
    else if (model == 1u)
    { qc[0] = x[0]; qc[1] = x[1]; qc[5] = x[2]; qc[6] = x[3]; qc[7] = x[4]; qc[8] = x[5]; }
    else
    { qc[0] = 1.0f; qc[1] = 1.0f; qc[5] = x[0]; qc[6] = x[1]; qc[7] = x[2]; qc[8] = x[3]; }
    return 1;
}

/*
 * The COMMITTED calibration, written back as quadric coefficients in the
 * current conditioning frame, so it can be scored against exactly the same
 * data as a candidate refit.
 *
 * Rev 1 compared a candidate's residual against the residual the committed
 * parameters had scored on a DIFFERENT, older window.  That is not a
 * comparison, and one lucky low-residual fit on a small patch of sphere could
 * set a bar no honest later fit could clear - the calibration then froze
 * forever on an over-fitted answer.
 */
static uint8_t mf_cal_committed_qc(const mag_cal_t *c, float qc[9], float *kout)
{
    float Q[9], Wt[9], p[3], Qp[3], rho2, q00;
    uint8_t i, j;

    if (!c->valid || !(c->s0 > 1.0e-6f) || !(c->radius > 1.0e-6f)) return 0;

    for (i = 0; i < 3u; i++)
        for (j = 0; j < 3u; j++)
            Wt[3*i+j] = c->W[3*j+i];
    mf_m3_mul(Wt, c->W, Q);                     /* Q = W^T W */

    q00 = Q[0];
    if (!(q00 > 1.0e-12f)) return 0;

    for (i = 0; i < 3u; i++) p[i] = (c->offset[i] - c->c0[i]) / c->s0;
    mf_m3_apply(Q, p, Qp);
    rho2 = (c->radius / c->s0) * (c->radius / c->s0);

    qc[0] = Q[4] / q00;
    qc[1] = Q[8] / q00;
    qc[2] = 2.0f * Q[1] / q00;
    qc[3] = 2.0f * Q[2] / q00;
    qc[4] = 2.0f * Q[5] / q00;
    qc[5] = -2.0f * Qp[0] / q00;
    qc[6] = -2.0f * Qp[1] / q00;
    qc[7] = -2.0f * Qp[2] / q00;
    qc[8] = (p[0]*Qp[0] + p[1]*Qp[1] + p[2]*Qp[2] - rho2) / q00;

    for (i = 0; i < 9u; i++) if (!isfinite(qc[i])) return 0;
    if (kout) *kout = rho2 / q00;
    return 1;
}

/* Sum the two half-matrices into one. */
static void mf_cal_all(const mag_cal_t *c, float *out)
{
    uint8_t i;
#if MAG_CAL_CV
    for (i = 0; i < MF_NSYM; i++) out[i] = c->M[0][i] + c->M[1][i];
#else
    for (i = 0; i < MF_NSYM; i++) out[i] = c->M[0][i];
#endif
}

/*
 * Model selection by cross-validation, then a refit of the winner on all the
 * data.  Rev 1 picked the model by comparing IN-SAMPLE residuals, which
 * always favours the richer model for the wrong reason.
 */
static uint8_t mf_cal_try(const mag_cal_t *c, const float *Mall,
                          float W[9], float cen[3], float *r,
                          float *quality, uint8_t *model)
{
    float cv[3];
    uint8_t ok[3], m, best;
    uint8_t nbins = mf_popcount(c->bins);

    for (m = 0; m < 3u; m++) { cv[m] = 1.0e9f; ok[m] = 0u; }

    for (m = 0; m < 3u; m++)
    {
        uint32_t need_n;
        uint8_t  need_b;
        float qc[9], W2[9], c2[3], r2, k2;

        if      (m == 2u) { need_n = MAG_CAL_FULL_MIN;   need_b = MAG_CAL_BINS_FULL; }
        else if (m == 1u) { need_n = MAG_CAL_DIAG_MIN;   need_b = MAG_CAL_BINS_DIAG; }
        else              { need_n = MAG_CAL_SPHERE_MIN; need_b = MAG_CAL_BINS_SPH;  }

        if (c->n < need_n || nbins < need_b) continue;

#if MAG_CAL_CV
        {
            float s = 0.0f;
            uint8_t half, good = 1u;
            for (half = 0; half < 2u; half++)
            {
                if (!mf_quad_solve(c->M[half], m, qc)) { good = 0u; break; }
                if (!mf_quad_params(qc, m, W2, c2, &r2, &k2)) { good = 0u; break; }
                s += mf_quad_score(c->M[half ^ 1u], qc, k2);
            }
            if (!good) continue;
            cv[m] = 0.5f * s;
        }
#else
        if (!mf_quad_solve(Mall, m, qc)) continue;
        if (!mf_quad_params(qc, m, W2, c2, &r2, &k2)) continue;
        cv[m] = mf_quad_score(Mall, qc, k2);
#endif
        ok[m] = 1u;
    }

    /* Prefer the simplest model unless the richer one earns it out of
     * sample.  This is the guard against low-coverage overfitting. */
    if (ok[2] && (cv[2] < MAG_CAL_MAX_RESIDUAL) &&
        (!ok[1] || (cv[2] < cv[1] * MAG_CAL_FULL_GAIN)))            best = 2u;
    else if (ok[1] && (cv[1] < MAG_CAL_MAX_RESIDUAL) &&
             (!ok[0] || (cv[1] < cv[0] * MAG_CAL_DIAG_GAIN)))       best = 1u;
    else if (ok[0] && (cv[0] < MAG_CAL_MAX_RESIDUAL))               best = 0u;
    else return 0u;

    {
        float qc[9], k;
        if (!mf_quad_solve(Mall, best, qc)) return 0u;
        if (!mf_quad_params(qc, best, W, cen, r, &k)) return 0u;
        *quality = mf_quad_score(Mall, qc, k);
        *model   = best;
    }
    return 1u;
}

static uint8_t mf_cal_solve(mag_cal_t *c)
{
    float Mall[MF_NSYM];
    float W[9], cen[3], r, quality;
    uint8_t model, i;

    if (c->n < MAG_CAL_SPHERE_MIN) return MAG_CAL_ERR_SAMPLES;
    if (mf_popcount(c->bins) < MAG_CAL_BINS_SPH) return MAG_CAL_ERR_COVERAGE;

    mf_cal_all(c, Mall);
    if (!mf_cal_try(c, Mall, W, cen, &r, &quality, &model)) return MAG_CAL_ERR_SOLVE;

    {
        float radius = c->s0 * r;
        float offset[3];
        for (i = 0; i < 3; i++) offset[i] = c->c0[i] + c->s0 * cen[i];
        if (!(radius > 0.0f) || !isfinite(radius)) return MAG_CAL_ERR_SOLVE;

        for (i = 0; i < 3; i++)
        {
            float wn = sqrtf(W[3*i]*W[3*i] + W[3*i+1]*W[3*i+1] + W[3*i+2]*W[3*i+2]);
            if (((c->hi[i] - c->lo[i]) * wn) < MAG_CAL_COVERAGE * radius)
                return MAG_CAL_ERR_COVERAGE;
        }

#if MAG_CAL_REFINE
        /* Score the COMMITTED parameters on the very same data and only
         * replace them if the candidate is genuinely better. */
        if (c->valid)
        {
            float qold[9], kold, old_score;
            if (mf_cal_committed_qc(c, qold, &kold))
            {
                old_score = mf_quad_score(Mall, qold, kold);
                if (!(quality < old_score * MAG_CAL_REFINE_GAIN))
                    return MAG_CAL_ERR_RESIDUAL;
            }
        }
#endif
        memcpy(c->W, W, sizeof(c->W));
        for (i = 0; i < 3; i++) c->offset[i] = offset[i];
        c->radius  = radius;
        c->quality = quality;
        c->model   = model;
    }

    c->valid = 1;
    c->geo_q = 1.0e9f;              /* re-measure against the new parameters */
    if (c->revision < 0xFFFFFFFFu) c->revision++;
#if MAG_CAL_REFINE
    c->active = 2u;
#else
    c->active = 0u;
#endif
    return MAG_CAL_OK;
}

/* Raw -> normalised (|u| ~ 1), BEFORE the mag-to-IMU rotation. */
static void mf_cal_apply(const mag_cal_t *c, const float raw[3], float u[3])
{
    float d[3], m[3];
    float inv = (c->radius > 1.0e-6f) ? (1.0f / c->radius) : 0.0f;
    uint8_t i;
    for (i = 0; i < 3; i++) d[i] = raw[i] - c->offset[i];
    mf_m3_apply(c->W, d, m);
    for (i = 0; i < 3; i++) u[i] = m[i] * inv;
}

/* ======================================================================== */
/*  Cross-link consensus (optional)                                         */
/* ======================================================================== */
/*
 * Twenty links on one hand share ONE earth field.  |B| and the dip angle are
 * yaw-invariant, so unlike a heading they are directly comparable between
 * links that each have their own arbitrary 6-axis yaw datum.
 *
 * This gives a disturbance detector with a 15 cm baseline.  The two parts on
 * one board are about 8 mm apart, so a source 30 cm away only shows ~8% of
 * its amplitude as a gradient between them; the same source is essentially
 * invisible to the far side of the hand, which makes the disagreement nearly
 * 100% of the amplitude.  The median is used, so it takes more than half the
 * hand being disturbed before the reference itself moves.
 */
typedef struct {
    float    norm, dip;
    uint32_t stamp;
    uint8_t  valid;
} mf_peer_t;

static mf_peer_t mf_fleet[MAG_FLEET_MAX];
static uint32_t  mf_fleet_tick;

void mag_fusion_join_fleet(mag_fusion_t *f, uint8_t index)
{
    if (index >= MAG_FLEET_MAX) return;
    f->fleet_idx    = index;
    f->fleet_joined = 1u;
    mf_fleet[index].valid = 0u;
}

static void mf_fleet_publish(mag_fusion_t *f, float norm, float dip)
{
    if (!f->fleet_joined) return;
    mf_fleet_tick++;
    mf_fleet[f->fleet_idx].norm  = norm;
    mf_fleet[f->fleet_idx].dip   = dip;
    mf_fleet[f->fleet_idx].stamp = mf_fleet_tick;
    mf_fleet[f->fleet_idx].valid = 1u;
}

static float mf_median(float *v, uint8_t n)
{
    uint8_t i, j;
    for (i = 1u; i < n; i++)            /* insertion sort, n <= 24 */
    {
        float key = v[i];
        j = i;
        while (j > 0u && v[j-1u] > key) { v[j] = v[j-1u]; j--; }
        v[j] = key;
    }
    return (n & 1u) ? v[n/2u] : (0.5f * (v[n/2u - 1u] + v[n/2u]));
}

static uint8_t mf_fleet_consensus(const mag_fusion_t *f, float *norm, float *dip)
{
    float vn[MAG_FLEET_MAX], vd[MAG_FLEET_MAX];
    uint8_t i, n = 0;

    if (!f->fleet_joined) return 0u;
    for (i = 0; i < MAG_FLEET_MAX; i++)
    {
        if (i == f->fleet_idx) continue;
        if (!mf_fleet[i].valid) continue;
        if ((mf_fleet_tick - mf_fleet[i].stamp) > (4u * MAG_FLEET_MAX)) continue;
        vn[n] = mf_fleet[i].norm;
        vd[n] = mf_fleet[i].dip;
        n++;
    }
    if (n < MAG_FLEET_MIN_PEERS) return 0u;
    *norm = mf_median(vn, n);
    *dip  = mf_median(vd, n);
    return 1u;
}

/* ======================================================================== */
/*  Affine map between the two magnetometers                                */
/* ======================================================================== */
/*
 * u1 ~ map * u2 + map_c.
 *
 * The two parts sit in different soft-iron environments, so their readings do
 * NOT differ by a pure rotation.  Rev 1 forced one (Procrustes), which left
 * an attitude-dependent residual that either failed the orthogonality check
 * outright - dropping the second magnetometer entirely - or squeaked through
 * with a residual so large the learned gradient threshold pinned itself to
 * the ceiling.  Either way the second part stopped earning its place.
 *
 * Twelve unknowns, but the design matrix [u2 1] is shared by all three output
 * components, so it is one 4x4 normal matrix and three right-hand sides.
 */
static void mf_map_reset(mag_fusion_t *f)
{
    memset(f->map_A, 0, sizeof(f->map_A));
    memset(f->map_b, 0, sizeof(f->map_b));
    f->map_n = 0.0f;
    f->map_since = 0;
    f->map_last[0] = f->map_last[1] = f->map_last[2] = 0.0f;
}

static uint8_t mf_sym4(uint8_t i, uint8_t j)
{
    if (i > j) { uint8_t t = i; i = j; j = t; }
    return (uint8_t)(i * 4u - (i * (i - 1u)) / 2u + (j - i));
}

static void mf_map_update(mag_fusion_t *f, float dt)
{
    float a[4], lam;
    uint8_t i, j;

    if (!f->cal[0].valid || !f->cal[1].valid) return;
    if (!f->u1_valid || !f->u2_valid) return;

    if (f->map_n > 0.0f)
    {
        float dx = f->u1[0] - f->map_last[0];
        float dy = f->u1[1] - f->map_last[1];
        float dz = f->u1[2] - f->map_last[2];
        if ((dx*dx + dy*dy + dz*dz) < (MAG_MAP_STEP * MAG_MAP_STEP)) return;
    }

    /* Exponential forgetting: the relationship is fixed by geometry, but the
     * calibration underneath it is not, so old pairs must age out. */
    lam = expf(-dt / MAG_MAP_TAU_S);
    if (!(lam > 0.0f) || lam > 1.0f) lam = 1.0f;
    for (i = 0; i < 10u; i++) f->map_A[i] *= lam;
    for (i = 0; i < 12u; i++) f->map_b[i] *= lam;
    f->map_n *= lam;

    a[0] = f->u2[0]; a[1] = f->u2[1]; a[2] = f->u2[2]; a[3] = 1.0f;
    for (i = 0; i < 4u; i++)
        for (j = i; j < 4u; j++)
            f->map_A[mf_sym4(i, j)] += a[i] * a[j];
    for (i = 0; i < 3u; i++)
        for (j = 0; j < 4u; j++)
            f->map_b[i*4u + j] += f->u1[i] * a[j];
    f->map_n += 1.0f;
    memcpy(f->map_last, f->u1, sizeof(f->map_last));

    if (++f->map_since < MAG_MAP_EVERY) return;
    f->map_since = 0;
    if (f->map_n < MAG_MAP_MIN_N) return;

    {
        float M[9], c[3], sse = 0.0f;
        uint8_t good = 1u;
        for (i = 0; i < 3u; i++)
        {
            float A4[16], b4[4], x4[4];
            uint8_t p, qq;
            for (p = 0; p < 4u; p++)
            {
                for (qq = 0; qq < 4u; qq++) A4[p*4u+qq] = f->map_A[mf_sym4(p, qq)];
                b4[p] = f->map_b[i*4u + p];
            }
            if (!mf_solve(A4, b4, x4, 4u)) { good = 0u; break; }
            M[3*i] = x4[0]; M[3*i+1] = x4[1]; M[3*i+2] = x4[2]; c[i] = x4[3];
            /* residual = sum u1_i^2 - x^T b, and sum u1_i^2 is not stored, so
             * use the normal-equation identity on the fitted part only. */
            for (p = 0; p < 4u; p++) sse -= x4[p] * f->map_b[i*4u + p];
        }
        if (!good) return;
        /* sum |u1|^2 ~ map_n because u1 is normalised to the field radius. */
        sse += f->map_n;
        if (sse < 0.0f) sse = 0.0f;
        {
            float res = sqrtf(sse / f->map_n);
            if (res < MAG_MAP_RES_MAX)
            {
                memcpy(f->map, M, sizeof(M));
                memcpy(f->map_c, c, sizeof(c));
                f->map_res   = res;
                f->map_valid = 1u;
            }
        }
    }
}

/* ======================================================================== */
/*  Mag-to-IMU rotation / earth field / body offset                         */
/* ======================================================================== */

static void mf_fe_reset(mag_field_est_t *fe)
{
    fe->n = 0.0f;
    memset(fe->SR, 0, sizeof(fe->SR));
    memset(fe->T,  0, sizeof(fe->T));
    memset(fe->Sm, 0, sizeof(fe->Sm));
    fe->Smm = 0.0f;
    fe->have_last = 0u;
    fe->since = 0u;
    fe->d_run = 0u;
}

static void mf_fe_init(mag_field_est_t *fe)
{
    memset(fe, 0, sizeof(*fe));
    mf_fe_reset(fe);
}

/*
 * One (attitude, reading) pair.  Decimated on ATTITUDE, not on the reading:
 * the whole point is orientation diversity, and a board held still
 * contributes nothing no matter how many samples it produces.
 *
 * Accumulation is UNCONDITIONAL and carries exponential forgetting.  Rev 1
 * only accumulated after a fault had already been declared, and never forgot,
 * so a window polluted while the magnet was still nearby stayed polluted and
 * the recovery solve could never pass its residual test again.
 */
static void mf_fe_accum(mag_field_est_t *fe, const float q[4], const float m[3],
                        float dt)
{
    float R[9], lam;
    uint8_t i, j, l;

    if (fe->have_last && mf_q_angle(fe->last_q, q) < MAG_FE_STEP_RAD) return;
    memcpy(fe->last_q, q, sizeof(fe->last_q));
    fe->have_last = 1u;

    lam = expf(-dt / MAG_FE_TAU_S);
    if (!(lam > 0.0f) || lam > 1.0f) lam = 1.0f;
    fe->n *= lam;
    fe->Smm *= lam;
    for (i = 0; i < 9u;  i++) fe->SR[i] *= lam;
    for (i = 0; i < 27u; i++) fe->T[i]  *= lam;
    for (i = 0; i < 3u;  i++) fe->Sm[i] *= lam;

    mf_q_to_m3(q, R);
    for (i = 0; i < 9u; i++) fe->SR[i] += R[i];
    for (j = 0; j < 3u; j++)
        for (i = 0; i < 3u; i++)
            for (l = 0; l < 3u; l++)
                fe->T[j*9u + i*3u + l] += R[j*3u + i] * m[l];
    for (i = 0; i < 3u; i++) fe->Sm[i] += m[i];
    fe->Smm += m[0]*m[0] + m[1]*m[1] + m[2]*m[2];
    fe->n   += 1.0f;
    fe->since++;
}

/* Given A, solve the linear system for (B, d) and return the residual. */
static uint8_t mf_fe_linear(const mag_field_est_t *fe, const float A[9],
                            float B[3], float d[3], float *res)
{
    float Sw[3], Sb[3], M[36], b[6], x[6];
    float n = fe->n, invn, be, dn, r;
    uint8_t i, j, l;

    if (!(n >= MAG_FE_MIN_N)) return 0u;
    invn = 1.0f / n;

    for (j = 0; j < 3u; j++)
    {
        float s = 0.0f;
        for (i = 0; i < 3u; i++)
            for (l = 0; l < 3u; l++)
                s += A[i*3u + l] * fe->T[j*9u + i*3u + l];
        Sw[j] = s;
    }
    mf_m3_apply(A, fe->Sm, Sb);

    for (i = 0; i < 36u; i++) M[i] = 0.0f;
    for (i = 0; i < 3u; i++)
    {
        M[i*6+i]           = n;
        M[(i+3u)*6+(i+3u)] = n;
        for (j = 0; j < 3u; j++)
        {
            M[i*6 + (j+3u)] = fe->SR[3*i + j];
            M[(j+3u)*6 + i] = fe->SR[3*i + j];
        }
        b[i]    = Sw[i];
        b[i+3u] = Sb[i];
    }
    if (!mf_solve(M, b, x, 6u)) return 0u;

    be = sqrtf(x[0]*x[0] + x[1]*x[1] + x[2]*x[2]);
    dn = sqrtf(x[3]*x[3] + x[4]*x[4] + x[5]*x[5]);
    if (!isfinite(be) || !isfinite(dn)) return 0u;

    {
        float t1 = x[0]*Sw[0] + x[1]*Sw[1] + x[2]*Sw[2];
        float t2 = x[3]*Sb[0] + x[4]*Sb[1] + x[5]*Sb[2];
        float t3 = 0.0f;
        for (i = 0; i < 3u; i++)
            for (j = 0; j < 3u; j++)
                t3 += x[i] * fe->SR[3*i + j] * x[3u + j];
        r = fe->Smm - 2.0f*(t1 + t2) + n*(be*be + dn*dn) + 2.0f*t3;
        if (r < 0.0f) r = 0.0f;
        r = sqrtf(r * invn);
    }

    B[0] = x[0]; B[1] = x[1]; B[2] = x[2];
    d[0] = x[3]; d[1] = x[4]; d[2] = x[5];
    *res = r;
    return 1u;
}

/* Given (B, d), the best A is the polar factor of  sum (R^T B + d) m^T. */
static uint8_t mf_fe_rotation(const mag_field_est_t *fe, const float B[3],
                              const float d[3], float A[9])
{
    float C[9];
    uint8_t i, j, l;

    for (i = 0; i < 3u; i++)
        for (l = 0; l < 3u; l++)
        {
            float s = d[i] * fe->Sm[l];
            for (j = 0; j < 3u; j++) s += B[j] * fe->T[j*9u + i*3u + l];
            C[i*3u + l] = s;
        }
    return mf_polar(C, A);
}

/*
 * Observability.  The mean of the attitude matrices collapses toward a
 * rotation when the board never turned and toward zero when it turned a lot.
 * With no rotation, "body fixed" and "world fixed" are the same thing and the
 * decomposition is genuinely meaningless - the estimator refuses rather than
 * guesses.
 */
static float mf_fe_obs(const mag_field_est_t *fe)
{
    float invn, o = 0.0f;
    uint8_t i;
    if (!(fe->n > 0.5f)) return 1.0f;
    invn = 1.0f / fe->n;
    for (i = 0; i < 9u; i++) { float v = fe->SR[i] * invn; o += v * v; }
    return o / 3.0f;
}

/* Fold a body-fixed offset into the stored hard-iron centre.
 * u = A W (raw - b) / r, and we want u to drop by d, so
 * W (raw - b') / r = W (raw - b)/r - A^T d  =>  b' = b + r W^-1 A^T d. */
static void mf_fe_fold(mag_cal_t *c, const float A[9], const float d[3])
{
    float Wi[9], dd[3], s[3];
    uint8_t i;
    if (!mf_m3_inv(c->W, Wi)) return;
    mf_m3_applyT(A, d, dd);
    for (i = 0; i < 3u; i++) dd[i] *= c->radius;
    mf_m3_apply(Wi, dd, s);
    for (i = 0; i < 3u; i++) c->offset[i] += s[i];
}

/*
 * Alternating solve for (A, B, d).  Three rounds from the current A, then a
 * cold restart from identity if that did not converge - the cold start
 * matters when the true mounting is a 90 degree axis swap, where staying near
 * the current estimate can stall.
 */
static uint8_t mf_fe_solve(const mag_field_est_t *fe, const float A0[9],
                           float A[9], float B[3], float d[3], float *res)
{
    float Acur[9], Bc[3], dc[3], r = 1.0e9f, best = 1.0e9f;
    float Ab[9], Bb[3], db[3];
    uint8_t pass, it, got = 0u;

    mf_m3_identity(Ab);
    Bb[0] = Bb[1] = Bb[2] = 0.0f;
    db[0] = db[1] = db[2] = 0.0f;

    for (pass = 0; pass < 2u; pass++)
    {
        uint8_t bad = 0u;

        if (pass == 0u) memcpy(Acur, A0, sizeof(Acur));
        else            mf_m3_identity(Acur);

        for (it = 0; it < 6u; it++)
        {
            float An[9];
            if (!mf_fe_linear(fe, Acur, Bc, dc, &r)) { bad = 1u; break; }
            if (!mf_fe_rotation(fe, Bc, dc, An)) break;
            memcpy(Acur, An, sizeof(Acur));
        }
        if (bad) break;
        if (!mf_fe_linear(fe, Acur, Bc, dc, &r)) continue;
        if (r < best)
        {
            best = r;
            memcpy(Ab, Acur, sizeof(Ab));
            memcpy(Bb, Bc, sizeof(Bb));
            memcpy(db, dc, sizeof(db));
            got = 1u;
        }
    }
    if (!got) return 0u;
    memcpy(A, Ab, sizeof(Ab));
    memcpy(B, Bb, sizeof(Bb));
    memcpy(d, db, sizeof(db));
    *res = best;
    return 1u;
}

/* ======================================================================== */
/*  Lifecycle                                                               */
/* ======================================================================== */

static void mf_world_reset(mag_fusion_t *f)
{
    memset(f->wring, 0, sizeof(f->wring));
    f->wsum[0] = f->wsum[1] = f->wsum[2] = 0.0f;
    f->wring_n = 0;
    f->wring_i = 0;
    f->w_hist  = 0;
    f->w_lp_valid  = 0u;
    f->anchor_valid = 0u;
    f->anchor_s = 0.0f;
    f->drift_run = 0u;
}

void mag_fusion_init(mag_fusion_t *f)
{
    memset(f, 0, sizeof(*f));
    mf_cal_init(&f->cal[0]);
    mf_cal_init(&f->cal[1]);
    mf_fe_init(&f->fe);
    mf_m3_identity(f->A);
    mf_m3_identity(f->map);
    mf_map_reset(f);
    mf_world_reset(f);
    f->grad_thr  = MAG_GRAD_CEIL;
    f->sigma     = MAG_NOISE_MAX;
    f->ref_norm  = f->ref_norm0 = 1.0f;
    f->yaw_P     = MAG_YAW_P0;
    f->motion_hold_s = MAG_MOTION_GUARD_HOLD_S;
    f->status    = MAG_ST_NO_CAL;
}

/*
 * Partial reset: everything LEARNED FROM the magnetic datum is stale and must
 * go; everything learned independently of it stays.  In particular the yaw
 * correction is kept - it was right before and it is still right, and
 * dropping it would throw the output back to the 6-axis solution's arbitrary
 * yaw datum, a jump of tens of degrees.
 */
static void mf_partial_reset(mag_fusion_t *f)
{
    f->ref_norm = f->ref_norm0 = 1.0f;
    f->ref_dip_valid = 0u;
    f->ref_dip_n     = 0u;
    f->ref_dip_acc   = 0.0f;

    f->hard_event = 0u;
    f->cand_valid = 0u;
    f->cand_s     = 0.0f;
    f->head_rebase_s = 0.0f;
    f->safe_valid = 0u;
    f->safe_yaw_valid = 0u;
    f->safe_datum = 0.0f;
    f->good_s     = 0.0f;
    f->rejecting  = 0u;
    f->weight     = 0.0f;
    f->coast_acc  = 0.0f;
    f->drift_anchored = 0u;
    f->e_inst = f->e_lp = 0.0f;
    f->e_norm = f->e_dip = f->e_step = f->e_drift = f->e_grad = f->e_fleet = 0.0f;
    f->diag_hold = 0u;
    f->motion_hold_s = MAG_MOTION_GUARD_HOLD_S;
    f->recovery_good_s = 0.0f;
    f->motion_recover_armed = 0u;
    f->yaw_P = (f->yaw_P > MAG_YAW_P_MAX) ? MAG_YAW_P_MAX : f->yaw_P;
    f->yaw_blend = 0.0f;
    f->yaw_blend_valid = 0u;
    mf_world_reset(f);
    /* drift_rate, sigma, the gradient floor, A, the map, the calibration and
     * the field estimator are properties of the hardware, not of the magnetic
     * datum, so they deliberately survive. */
}

void mag_fusion_reset_runtime(mag_fusion_t *f)
{
    f->u1_valid  = 0;
    f->u2_valid  = 0;
    f->seq_used  = f->seq1;
    f->yaw_valid = 0;
    f->yaw_corr  = 0.0f;
    f->yaw_P     = MAG_YAW_P0;
    f->mag_datum_offset = 0.0f;
    f->cal_commit_pending = 0u;
    f->have_prev = 0;
    f->stale_s   = 0.0f;
    f->stale2_s  = 0.0f;
    f->q_stab_valid = 0u;
    f->motion_hold  = 0u;
    mf_partial_reset(f);
    f->status = f->cal[0].valid ? MAG_ST_ACQUIRING : MAG_ST_NO_CAL;
}

void mag_fusion_rebase_runtime(mag_fusion_t *f)
{
    mf_partial_reset(f);
    if (f->yaw_valid) f->cal_commit_pending = 1u;
}

void mag_fusion_cal_start(mag_fusion_t *f)
{
    uint8_t s;
    for (s = 0; s < 2u; s++)
    {
        mf_cal_zero(&f->cal[s]);
        f->cal[s].active = 1u;
        f->cal[s].result = MAG_CAL_NONE;
        f->cal[s].valid  = 0;
    }
    mf_map_reset(f);
    f->map_valid = 0;
    mf_fe_reset(&f->fe);
    mf_partial_reset(f);
    f->cal_commit_pending = 1u;
    f->status = MAG_ST_CALIBRATING;
}

void mag_fusion_cal_clear(mag_fusion_t *f)
{
    uint8_t s, i;
    for (s = 0; s < 2u; s++)
    {
        f->cal[s].valid  = 0;
        f->cal[s].radius = 0.0f;
        for (i = 0; i < 3; i++) f->cal[s].offset[i] = 0.0f;
        mf_m3_identity(f->cal[s].W);
        f->cal[s].quality = 1.0e9f;
        f->cal[s].geo_q   = 1.0e9f;
        f->cal[s].model = 0u;
        mf_cal_zero(&f->cal[s]);
        f->cal[s].result = MAG_CAL_CLEARED;
#if MAG_CAL_AUTO
        f->cal[s].active = 2u;
#else
        f->cal[s].active = 0u;
#endif
    }
    mf_map_reset(f);
    f->map_valid = 0;
    mf_m3_identity(f->map);
    f->map_c[0] = f->map_c[1] = f->map_c[2] = 0.0f;
    mf_fe_reset(&f->fe);
    /* A survives: it is a property of how the parts are mounted, not of the
     * hard/soft iron, and re-learning it costs another minute of waving. */
    mf_partial_reset(f);
    f->cal_commit_pending = 1u;
}

uint8_t mag_fusion_cal_finish(mag_fusion_t *f)
{
    uint8_t res[2], s;
    uint8_t did_solve[2] = {0u, 0u};

    for (s = 0; s < 2u; s++)
    {
        if (f->cal[s].active != 1u)
        {
            res[s] = f->cal[s].valid ? MAG_CAL_OK : MAG_CAL_ERR_SAMPLES;
            continue;
        }
        did_solve[s] = 1u;
        {
            uint8_t was_valid = f->cal[s].valid;
            res[s] = mf_cal_solve(&f->cal[s]);
            if (!was_valid || (res[s] == MAG_CAL_OK))
                f->cal[s].result = res[s];
        }
        if (res[s] != MAG_CAL_OK)
        {
#if MAG_CAL_AUTO
            f->cal[s].active = 2u;
#else
            f->cal[s].active = 0u;
            mf_cal_zero(&f->cal[s]);
#endif
        }
    }

    if (res[0] == MAG_CAL_OK)
    {
        if (!did_solve[0])
            return MAG_CAL_OK;   /* save-only request: never disturb dip/yaw */
        /* A verified explicit calibration becomes the immutable base.  Online
         * motion may update the dynamic body offset, but it must not silently
         * keep refitting/replacing W/A/radius. */
        f->cal[0].active = 0u;
        if (res[1] == MAG_CAL_OK) f->cal[1].active = 0u;
        mf_partial_reset(f);
        f->cal_commit_pending = 1u;
    }
    else f->status = f->cal[0].valid ? MAG_ST_ACQUIRING : MAG_ST_NO_CAL;

    return res[0];
}

uint8_t mag_fusion_dual_ready(const mag_fusion_t *f)
{
    return (uint8_t)(f->have2 && f->cal[0].valid && f->cal[1].valid && f->map_valid);
}

/* ======================================================================== */
/*  Measurement input                                                       */
/* ======================================================================== */

/* Only one link is allowed to run a fit per pass, so twenty links whose
 * sample counts advance in lockstep cannot all refit in the same 10 ms tick. */
static uint8_t mf_fit_token;

static void mf_cal_feed(mag_cal_t *c, const float raw[3], float dt)
{
    if (!c->active) return;
    mf_cal_accum(c, raw, dt);

    if (c->n >= c->next_try)
    {
        if (mf_fit_token) return;       /* another link has the budget */
        mf_fit_token = 1u;
        c->next_try = c->n + (c->valid ? MAG_CAL_REFINE_EVERY : MAG_CAL_RETRY_EVERY);
        {
            uint8_t attempt = mf_cal_solve(c);
            if (!c->valid || (attempt == MAG_CAL_OK)) c->result = attempt;
#if MAG_CAL_AUTO
            if (!c->valid && (attempt != MAG_CAL_OK) && (c->active == 0u))
                c->active = 2u;
#endif
        }
    }

#if MAG_CAL_REFINE
    /* Bound the window on BOTH sample count and wall time so the fit can
     * follow the thermal drift of a magnetometer strapped to a warm hand.
     * A count-only window can span hours if the hand is mostly still. */
    if (c->valid && ((c->n > MAG_CAL_REFINE_MAX_N) ||
                     (c->window_s > MAG_CAL_WINDOW_S)))
    {
        float W[9], off[3], rad, qual, gq;
        uint8_t mdl;
        memcpy(W, c->W, sizeof(W)); memcpy(off, c->offset, sizeof(off));
        rad = c->radius; qual = c->quality; mdl = c->model; gq = c->geo_q;
        mf_cal_zero(c);
        memcpy(c->W, W, sizeof(W)); memcpy(c->offset, off, sizeof(off));
        c->radius = rad; c->quality = qual; c->model = mdl; c->geo_q = gq;
        c->active = 2u;
    }
#endif
}

/* Running geometric quality of the COMMITTED fit, in field radii.  Unlike the
 * algebraic residual this is a physical number and is comparable across
 * windows, sensors and links. */
static void mf_cal_track_geo(mag_cal_t *c, const float u[3])
{
    float e = fabsf(sqrtf(u[0]*u[0] + u[1]*u[1] + u[2]*u[2]) - 1.0f);
    if (!(c->geo_q < 1.0e8f)) c->geo_q = e;
    else c->geo_q += 0.002f * (e - c->geo_q);
}

uint8_t mag_fusion_on_mag(mag_fusion_t *f, const float m_raw[3], float m_out[3])
{
    uint8_t was_valid = f->cal[0].valid;
    uint32_t cal_rev  = f->cal[0].revision;
    float fm[3];

    mf_fir_body(&f->cal[0], m_raw, fm);

    /* Explicit calibration always collects.  First-time background
     * calibration must also collect while the weight is still zero, or it
     * could never bootstrap.  Refinement of a committed fit only uses
     * samples the gates are reasonably happy with. */
    if ((f->cal[0].active == 1u) ||
        ((f->cal[0].active == 2u) &&
         (!f->cal[0].valid || (!f->hard_event && (f->e_lp < 1.0f)))))
        mf_cal_feed(&f->cal[0], fm, 0.01f);

    if ((!was_valid && f->cal[0].valid) || (f->cal[0].revision != cal_rev))
    {
        float keep_dip = f->ref_dip;
        float keep_norm = f->ref_norm;
        uint8_t keep_dip_valid = f->ref_dip_valid;
        mf_partial_reset(f);
        if (keep_dip_valid)
        {
            f->ref_dip = f->ref_dip0 = keep_dip;
            f->ref_norm = f->ref_norm0 = keep_norm;
            f->ref_dip_valid = 1u;
        }
        f->cal_commit_pending = 1u;
    }

    if (f->cal[0].valid)
    {
        mf_cal_apply(&f->cal[0], fm, f->u1);
        mf_cal_track_geo(&f->cal[0], f->u1);
        f->u1_valid = 1;
        f->seq1++;
        if (m_out)
        {
            float a[3];
            mf_m3_apply(f->A, f->u1, a);        /* IMU frame */
            m_out[0] = a[0] * f->cal[0].radius;
            m_out[1] = a[1] * f->cal[0].radius;
            m_out[2] = a[2] * f->cal[0].radius;
        }
        return 1;
    }

    f->u1_valid = 0;
    if (m_out) { m_out[0] = fm[0]; m_out[1] = fm[1]; m_out[2] = fm[2]; }
    return 0;
}

uint8_t mag_fusion_on_mag2(mag_fusion_t *f, const float m_raw[3], float m_out[3])
{
    float fm[3];

    f->have2 = 1;
    mf_fir_body(&f->cal[1], m_raw, fm);

    if ((f->cal[1].active == 1u) ||
        ((f->cal[1].active == 2u) &&
         (!f->cal[1].valid || (!f->hard_event && (f->e_lp < 1.0f)))))
        mf_cal_feed(&f->cal[1], fm, 0.01f);

    if (f->cal[1].valid)
    {
        mf_cal_apply(&f->cal[1], fm, f->u2);
        mf_cal_track_geo(&f->cal[1], f->u2);
        f->u2_valid = 1;
        f->seq2++;
        f->stale2_s = 0.0f;
        if (m_out)
        {
            m_out[0] = f->u2[0] * f->cal[1].radius;
            m_out[1] = f->u2[1] * f->cal[1].radius;
            m_out[2] = f->u2[2] * f->cal[1].radius;
        }
        return 1;
    }

    f->u2_valid = 0;
    if (m_out) { m_out[0] = fm[0]; m_out[1] = fm[1]; m_out[2] = fm[2]; }
    return 0;
}

/* ======================================================================== */
/*  Gyro input and the static output stabiliser                             */
/* ======================================================================== */

void mag_fusion_on_gyro(mag_fusion_t *f, const float g_raw[3])
{
    if (!f->gyro_valid)
    {
        f->gyro_bias[0] = g_raw[0];
        f->gyro_bias[1] = g_raw[1];
        f->gyro_bias[2] = g_raw[2];
        f->gyro_activity = 0.0f;
        f->gyro_valid = 1u;
    }
    else
    {
        uint8_t i;
        float d = 0.0f;
        for (i = 0u; i < 3u; i++)
        {
            float e = g_raw[i] - f->gyro_bias[i];
            d += e * e;
        }
        d = sqrtf(d);
        f->gyro_activity += MAG_STAB_GYRO_LPF * (d - f->gyro_activity);

        /*
         * Track the bias ONLY while the board is still.  Rev 1 adapted it
         * unconditionally, so a couple of seconds of steady rotation pulled
         * the "bias" onto the actual rate, the activity decayed to zero and
         * the stabiliser decided the board had stopped moving - freezing the
         * output mid-turn until the 5 degree breakout fired, then freezing
         * again.  That is the stutter, not sensor noise.
         */
        if (d < MAG_STAB_GYRO_MOVE_RAW)
            for (i = 0u; i < 3u; i++)
                f->gyro_bias[i] += MAG_STAB_GYRO_BIAS_LPF * (g_raw[i] - f->gyro_bias[i]);
    }

    if (f->gyro_activity > MAG_STAB_GYRO_MOVE_RAW)
        f->motion_hold = MAG_STAB_HOLD;
}

/*
 * Output-only attitude hold, applied to the 6-AXIS attitude only.
 *
 * Rev 1 ran this AFTER the yaw correction, with a 100 s time constant while
 * the board was still.  That low-passed its own correction: walk away from a
 * magnet while holding the hand steady and the internal heading recovered
 * immediately but the reported quaternion took a minute and a half to show
 * it.  The correction is already smoothed by its own filter and must not be
 * smoothed again here.
 */
static void mf_stabilize_attitude(mag_fusion_t *f, float q[4], float dt)
{
    float qraw[4];
    uint8_t moving = 0u;

    memcpy(qraw, q, sizeof(qraw));

    if (f->motion_hold > 0u) { f->motion_hold--; moving = 1u; }

    if (f->q_stab_valid && (mf_q_angle(f->q_stab, qraw) > MAG_STAB_BREAKOUT_RAD))
    {
        f->motion_hold = MAG_STAB_HOLD;
        moving = 1u;
    }

    if (!f->q_stab_valid)
    {
        memcpy(f->q_stab, qraw, sizeof(f->q_stab));
        f->q_stab_valid = 1u;
    }
    else
    {
        float dot = f->q_stab[0]*qraw[0] + f->q_stab[1]*qraw[1]
                  + f->q_stab[2]*qraw[2] + f->q_stab[3]*qraw[3];
        float tau = moving ? MAG_STAB_MOTION_TAU_S : MAG_STAB_STATIC_TAU_S;
        float a   = mf_clampf(1.0f - expf(-dt / tau), 0.0f, 1.0f);
        uint8_t i;

        if (dot < 0.0f) { for (i = 0u; i < 4u; i++) qraw[i] = -qraw[i]; }
        for (i = 0u; i < 4u; i++) f->q_stab[i] += a * (qraw[i] - f->q_stab[i]);
        mf_q_normalize(f->q_stab);
    }

    memcpy(q, f->q_stab, sizeof(f->q_stab));
}

/* ======================================================================== */
/*  Reference field tracking                                                */
/* ======================================================================== */

static void mf_ref_update(mag_fusion_t *f, float norm, float dip, float dt, float e)
{
    float k;

    if (f->hard_event || e > 1.0f) return;
    if (f->motion_hold_s < MAG_MOTION_GUARD_HOLD_S) return;

    if (!f->ref_dip_valid)
    {
        /*
         * The dip reference is NOT the mean of the first two seconds in
         * whatever pose the glove happened to boot in - with any residual
         * mag-to-IMU misalignment that pose's dip is wrong by several
         * degrees and every other orientation then trips the gate.  It comes
         * from the field estimator, which averages over every attitude the
         * hand has actually visited and is yaw-free by construction.  The
         * time-average below is only the fallback for a board that has not
         * turned enough yet, and it is not allowed to freeze on its own.
         */
        f->ref_dip_acc += dip;
        f->ref_dip_n++;
        if (f->ref_dip_n > 400u)
        {
            f->ref_dip   = f->ref_dip_acc / (float)f->ref_dip_n;
            f->ref_dip0  = f->ref_dip;
            f->ref_dip_acc = 0.0f;
            f->ref_dip_n   = 0u;
        }
        return;
    }

    k = dt / MAG_REF_TAU_S;
    if (k > 0.05f) k = 0.05f;

    f->ref_norm += k * (norm - f->ref_norm);
    f->ref_dip  += k * mf_wrap_pi(dip - f->ref_dip);

    f->ref_norm = mf_clampf(f->ref_norm,
                            f->ref_norm0 * (1.0f - MAG_REF_DRIFT_MAX),
                            f->ref_norm0 * (1.0f + MAG_REF_DRIFT_MAX));
    {
        float d   = mf_wrap_pi(f->ref_dip - f->ref_dip0);
        float lim = MAG_DIP_TOL_RAD * MAG_REF_DIP_SLACK;
        if (d >  lim) f->ref_dip = f->ref_dip0 + lim;
        if (d < -lim) f->ref_dip = f->ref_dip0 - lim;
        f->ref_dip = mf_wrap_pi(f->ref_dip);
    }
}

/* ======================================================================== */
/*  Field-estimator service                                                 */
/* ======================================================================== */

static float mf_cal_gate_pad(const mag_fusion_t *f)
{
    float p = MAG_CAL_GATE_K * f->cal[0].geo_q;
    if (f->cal[0].model < 2u) p += MAG_CAL_GATE_MIN;
    return mf_clampf(p, 0.0f, MAG_CAL_GATE_MAX);
}


static uint8_t mf_local_bin_index(const float q[4])
{
    float qi[4] = { q[0], -q[1], -q[2], -q[3] };
    float g[3];
    uint8_t b = 0u;
    mf_q_rotate(qi, (const float[]){0.0f, 0.0f, 1.0f}, g);
    if (g[0] >= 0.0f) b |= 1u;
    if (g[1] >= 0.0f) b |= 2u;
    if (g[2] >= 0.0f) b |= 4u;
    return b;
}

static void mf_local_clear_event(mag_fusion_t *f)
{
    f->local_commit_done = 1u;
    f->local_rearm_s = 0.0f;
    f->hard_event = 0u;
    f->rejecting = 0u;
    f->cand_valid = 0u;
    f->cal_commit_pending = 1u;
}

static void mf_local_d_commit(mag_fusion_t *f, const float d[3])
{
    float B[3], bn, bdip;
    memcpy(B, f->safe_B, sizeof(B));
    bn = sqrtf(B[0]*B[0] + B[1]*B[1] + B[2]*B[2]);
    if (!(bn > 1.0e-3f)) return;
    bdip = atan2f(B[2], sqrtf(B[0]*B[0] + B[1]*B[1]));
    mf_fe_fold(&f->cal[0], f->A, d);
    if (f->fe.fixes < 0xFFFFu) f->fe.fixes++;
    mf_fe_reset(&f->fe);
    memcpy(f->fe.B, B, sizeof(f->fe.B));
    f->fe.field_valid = 1u;
    f->fe.res = 0.0f;
    f->fe.obs = 0.0f;
    mf_partial_reset(f);
    f->ref_norm = f->ref_norm0 = bn;
    f->ref_dip  = f->ref_dip0  = bdip;
    f->ref_dip_valid = 1u;
    f->hard_event = 0u;
    f->rejecting = 0u;
    f->cand_valid = 0u;
    f->cal_commit_pending = 1u;
}

static void mf_local_d_update(mag_fusion_t *f, const float q[4], const float u_imu[3])
{
    float qc[4] = { q[0], -q[1], -q[2], -q[3] };
    float expected[3], de[3], dist;
    mag_local_bin_t *b;
    uint8_t bi;
    if (!f->hard_event || f->local_commit_done || !f->safe_B_valid || !f->cal[0].valid) return;
    if (f->motion_hold_s < MAG_MOTION_GUARD_HOLD_S) return;
    bi = mf_local_bin_index(q);
    b  = &f->local_bin[bi];
    mf_q_rotate(qc, f->safe_B, expected);
    de[0] = u_imu[0] - expected[0];
    de[1] = u_imu[1] - expected[1];
    de[2] = u_imu[2] - expected[2];
    if (b->valid)
    {
        dist = sqrtf((de[0]-b->d[0])*(de[0]-b->d[0]) +
                     (de[1]-b->d[1])*(de[1]-b->d[1]) +
                     (de[2]-b->d[2])*(de[2]-b->d[2]));
        if (dist < 0.10f)
        {
            if (b->committed) mf_local_clear_event(f);
            else { b->committed = 1u; mf_local_d_commit(f, b->d); }
            return;
        }
        b->valid = 0u; b->committed = 0u; b->count = 0u;
    }
    if (b->count == 0u)
    {
        memcpy(b->d, de, sizeof(b->d));
        b->spread = 0.0f; b->count = 1u; return;
    }
    dist = sqrtf((de[0]-b->d[0])*(de[0]-b->d[0]) +
                 (de[1]-b->d[1])*(de[1]-b->d[1]) +
                 (de[2]-b->d[2])*(de[2]-b->d[2]));
    if (dist > 0.12f)
    {
        memcpy(b->d, de, sizeof(b->d));
        b->spread = 0.0f; b->count = 1u; return;
    }
    for (int i = 0; i < 3; i++) b->d[i] += (de[i] - b->d[i]) / (float)(b->count + 1u);
    if (dist > b->spread) b->spread = dist;
    if (b->count < 0xFFu) b->count++;
    if (b->count >= 3u && b->spread < 0.08f)
    {
        b->valid = 1u;
        b->committed = 1u;
        mf_local_d_commit(f, b->d);
    }
}

static void mf_fe_service(mag_fusion_t *f, const float q[4], float dt)
{
    if (f->motion_hold_s < MAG_MOTION_GUARD_HOLD_S) return;
#if MAG_FE_ENABLE
    mag_field_est_t *fe = &f->fe;
    float A[9], B[3], d[3], res, be, dn, obs;

    mf_fe_accum(fe, q, f->u1, dt);

    if (fe->since < MAG_FE_EVERY) return;
    fe->since = 0u;

    obs = mf_fe_obs(fe);
    fe->obs = obs;
    if (obs > MAG_FE_OBS_MAX) return;       /* the board never turned */

    if (!mf_fe_solve(fe, f->A, A, B, d, &res)) return;

    be = sqrtf(B[0]*B[0] + B[1]*B[1] + B[2]*B[2]);
    dn = sqrtf(d[0]*d[0] + d[1]*d[1] + d[2]*d[2]);
    fe->res = res;
    if (!(be > 1.0e-3f)) return;
    if (fabsf(be - 1.0f) > MAG_FE_FIELD_TOL) return;
    if (dn > MAG_FE_D_MAX) return;
    if (res > MAG_FE_RES_MAX) return;

    memcpy(fe->B, B, sizeof(fe->B));
    memcpy(fe->d, d, sizeof(fe->d));

    /* ---- the earth field, and therefore the dip reference ---- */
    {
        float horiz = sqrtf(B[0]*B[0] + B[1]*B[1]);
        float dip   = atan2f(B[2], horiz);
        if (!fe->field_valid)
        {
            fe->field_valid  = 1u;
            f->ref_dip       = dip;
            f->ref_dip0      = dip;
            f->ref_dip_valid = 1u;
            f->ref_norm      = be;
            f->ref_norm0     = be;
        }
        if (!f->hard_event)
        {
            memcpy(f->safe_B, fe->B, sizeof(f->safe_B));
            f->safe_B_valid = 1u;
        }
        else
        {
            /* slow pull, the gates still own the fast path */
            f->ref_dip0 += 0.05f * mf_wrap_pi(dip - f->ref_dip0);
            f->ref_dip0  = mf_wrap_pi(f->ref_dip0);
            if (!f->ref_dip_valid)
            { f->ref_dip = f->ref_dip0; f->ref_dip_valid = 1u; }
        }
    }

    /* ---- the mag-to-IMU rotation ---- */
    if (res < MAG_FE_A_RES_MAX)
    {
        float dR[9], At[9], step, Anew[9];
        uint8_t i, j;

        for (i = 0; i < 3u; i++)
            for (j = 0; j < 3u; j++) At[3*i+j] = f->A[3*j+i];
        mf_m3_mul(A, At, dR);
        step = mf_m3_angle(dR);

        if (isfinite(step) && (step > 1.0e-4f))
        {
            uint8_t accept = 1u;

            if (step > MAG_FE_A_STEP_MAX)
            {
                /* Limit how far A may move in one go: it sits in the
                 * measurement path, so a single bad solve must not be able
                 * to throw the heading. */
                float s = MAG_FE_A_STEP_MAX / step;
                float C[9];
                for (i = 0; i < 9u; i++) C[i] = f->A[i] + s * (A[i] - f->A[i]);
                if (!mf_polar(C, Anew)) accept = 0u;
            }
            else memcpy(Anew, A, sizeof(Anew));

            if (accept && (mf_m3_angle(Anew) <= MAG_FE_A_MAX))
            {
                memcpy(f->A, Anew, sizeof(f->A));
                fe->align_valid = 1u;
                /* The magnetic datum moved because the measurement frame
                 * moved; re-anchor so the OUTPUT yaw does not step. */
                f->cal_commit_pending = 1u;
                /* The inter-sensor map is fitted in the pre-alignment frame,
                 * so it survives - but the world-frame history does not. */
                mf_world_reset(f);
            }
        }
        else fe->align_valid = 1u;
    }

    /* ---- board magnetisation / residual hard iron ----
     * Do not chase a body offset while the alignment is still young or the
     * solve is only marginally valid.  The old condition accepted res < 0.25,
     * which let calibration/model error masquerade as magnetisation and folded
     * 10+ times during a single sweep. */
    if ((dn >= MAG_FE_D_MIN) && (res < MAG_FE_D_RES_MAX) &&
        fe->align_valid && fe->field_valid && (fe->n >= MAG_FE_MIN_N))
        fe->d_run++;
    else
        fe->d_run = 0u;

    if (fe->d_run >= 3u)
    {
        float bdip = atan2f(B[2], sqrtf(B[0]*B[0] + B[1]*B[1]));
        mf_fe_fold(&f->cal[0], f->A, d);
        if (fe->fixes < 0xFFFFu) fe->fixes++;
        mf_fe_reset(fe);
        f->grad_mu = 0.0f; f->grad_var = 0.0f; f->grad_n = 0u;
        f->grad_thr = MAG_GRAD_CEIL;
        mf_map_reset(f);
        f->stuck_s = 0.0f;
        mf_partial_reset(f);
        /* Removing a body-fixed offset does not change the earth field dip.
         * Keep the freshly solved field as the datum instead of forcing the
         * host to wait through another acquire cycle. */
        f->ref_norm = f->ref_norm0 = be;
        f->ref_dip  = f->ref_dip0  = bdip;
        f->ref_dip_valid = 1u;
        f->cal_commit_pending = 1u;
    }
#else
    (void)f; (void)q; (void)dt;
#endif
}

/* ======================================================================== */
/*  Fusion step                                                             */
/* ======================================================================== */

uint8_t mag_fusion_on_quat(mag_fusion_t *f, uint64_t ts_ticks, float q[4])
{
    float dt, omega, w, e, e_event, target, alpha = 0.0f;
    float norm = 1.0f, horiz = 1.0f, dip = 0.0f;
    uint8_t fresh, dual = 0u;

    mf_fit_token = 0u;              /* one calibration fit per pass, per link */

    mf_q_normalize(q);

    if (f->have_prev && (ts_ticks > f->ts_prev))
    {
        dt = (float)(uint32_t)(ts_ticks - f->ts_prev) * MF_TICK_S;
        dt = mf_clampf(dt, 1.0e-3f, 0.2f);
        omega = mf_q_angle(f->q_prev, q) / dt;
    }
    else { dt = 0.01f; omega = 0.0f; }
    f->omega = omega;
    if (omega > MAG_MOTION_GUARD_RAD_S)
    {
        f->motion_hold_s = 0.0f;
        f->motion_recover_armed = 1u;
        f->recovery_good_s = 0.0f;
        f->head_rebase_s = 0.0f;
    }
    else
    {
        f->motion_hold_s += dt;
        if (f->motion_hold_s > MAG_MOTION_GUARD_HOLD_S)
            f->motion_hold_s = MAG_MOTION_GUARD_HOLD_S;
    }

    if (f->yaw_blend_valid)
    {
        float k = expf(-dt / MAG_YAW_BLEND_TAU_S);
        f->yaw_blend *= k;
        if (fabsf(f->yaw_blend) < 1.0e-4f)
        {
            f->yaw_blend = 0.0f;
            f->yaw_blend_valid = 0u;
        }
    }

    if (!f->hard_event)
    {
        f->local_rearm_s += dt;
        if (f->local_rearm_s > 30.0f) f->local_commit_done = 0u;
    }
    else f->local_rearm_s = 0.0f;

    memcpy(f->q_prev, q, sizeof(f->q_prev));
    f->ts_prev   = ts_ticks;
    f->have_prev = 1;

    fresh = (uint8_t)(f->u1_valid && (f->seq1 != f->seq_used));
    f->stale2_s += dt;

    if (!f->cal[0].valid)
    {
        f->status = f->cal[0].active ? MAG_ST_CALIBRATING : MAG_ST_NO_CAL;
        f->weight = 0.0f;
        mf_stabilize_attitude(f, q, dt);
        mf_apply_yaw_correction(f, q);
        return f->status;
    }

    if (fresh)
    {
        float ub[3], u1a[3], wnow[3];

        f->seq_used = f->seq1;
        f->stale_s  = 0.0f;

        /* Keep the secondary-to-primary map current.  It is fitted in the
         * pre-alignment frame so it is unaffected when A is adopted. */
        if (f->u2_valid && (f->stale2_s < 3.0f * dt) &&
            (f->motion_hold_s >= MAG_MOTION_GUARD_HOLD_S))
            mf_map_update(f, dt);

        /* -------- inter-magnetometer gradient, in the pre-alignment frame --
         * A is a rotation, so it does not change |u1 - u2m|; computing the
         * gradient before it keeps the map independent of A. */
        dual = (uint8_t)(mag_fusion_dual_ready(f) && f->u2_valid &&
                         (f->stale2_s < 3.0f * dt));
        f->e_grad = 0.0f;
        memcpy(ub, f->u1, sizeof(ub));

        if (dual)
        {
            float u2m[3], d[3], g;
            mf_m3_apply(f->map, f->u2, u2m);
            u2m[0] += f->map_c[0]; u2m[1] += f->map_c[1]; u2m[2] += f->map_c[2];
            d[0] = f->u1[0] - u2m[0];
            d[1] = f->u1[1] - u2m[1];
            d[2] = f->u1[2] - u2m[2];
            g = sqrtf(d[0]*d[0] + d[1]*d[1] + d[2]*d[2]);
            f->grad_now = g;
            if (f->grad_n >= MAG_GRAD_WARMUP) f->e_grad = g / f->grad_thr;

#if MAG_DUAL_AVERAGE
            /*
             * Averaging buys ~sqrt(2) of noise on the HEADING only, and it is
             * blended continuously rather than switched: rev 1 flipped
             * between "average" and "primary only" at a threshold crossing,
             * and every flip stepped the heading by half the inter-sensor
             * disagreement.
             */
            {
                float lam = mf_clampf(1.0f - f->e_grad, 0.0f, 1.0f);
                ub[0] = f->u1[0] + 0.5f * lam * (u2m[0] - f->u1[0]);
                ub[1] = f->u1[1] + 0.5f * lam * (u2m[1] - f->u1[1]);
                ub[2] = f->u1[2] + 0.5f * lam * (u2m[2] - f->u1[2]);
            }
#endif
        }
        else f->grad_now = 0.0f;

        /* -------- mag -> IMU rotation, then the world frame -------------- */
        mf_m3_apply(f->A, ub, u1a);
        mf_local_d_update(f, q, u1a);
        mf_q_rotate(q, u1a, wnow);
        memcpy(f->w_now, wnow, sizeof(f->w_now));

        /* -------- measured noise, from the second difference -------------
         * A second difference annihilates anything smooth, so what is left
         * is the per-sample noise of THIS hardware in THIS environment.  Every
         * gate below is scaled by it, which is why none of them can end up
         * sitting underneath the noise floor and rejecting for ever. */
        if (f->w_hist >= 2u)
        {
            float nx = wnow[0] - 2.0f*f->w_prev[0] + f->w_prev2[0];
            float ny = wnow[1] - 2.0f*f->w_prev[1] + f->w_prev2[1];
            float nz = wnow[2] - 2.0f*f->w_prev[2] + f->w_prev2[2];
            float s  = sqrtf((nx*nx + ny*ny + nz*nz) / 6.0f);
            float k  = (s < f->sigma) ? MAG_NOISE_FALL : MAG_NOISE_RISE;
            f->sigma += k * (s - f->sigma);
            f->sigma  = mf_clampf(f->sigma, MAG_NOISE_MIN, MAG_NOISE_MAX);
            if (f->sigma_n < 0xFFFFFFFFu) f->sigma_n++;
        }
        memcpy(f->w_prev2, f->w_prev, sizeof(f->w_prev2));
        memcpy(f->w_prev,  wnow,      sizeof(f->w_prev));
        if (f->w_hist < 2u) f->w_hist++;

        /* -------- world-frame boxcar ------------------------------------
         * The world vector is constant under body motion, so a long average
         * here has no motion-dependent distortion - unlike rev 1, which
         * low-passed the BODY vector inside the consistency gate and so
         * manufactured an error proportional to rotation rate. */
        {
            uint8_t i;
            if (f->wring_n >= MAG_WORLD_AVG)
                for (i = 0; i < 3u; i++) f->wsum[i] -= f->wring[f->wring_i][i];
            else f->wring_n++;
            for (i = 0; i < 3u; i++)
            {
                f->wring[f->wring_i][i] = wnow[i];
                f->wsum[i] += wnow[i];
            }
            f->wring_i = (uint8_t)((f->wring_i + 1u) % MAG_WORLD_AVG);
            for (i = 0; i < 3u; i++) f->w_lp[i] = f->wsum[i] / (float)f->wring_n;
            f->w_lp_valid = 1u;
        }

        norm  = sqrtf(f->w_lp[0]*f->w_lp[0] + f->w_lp[1]*f->w_lp[1] + f->w_lp[2]*f->w_lp[2]);
        horiz = sqrtf(f->w_lp[0]*f->w_lp[0] + f->w_lp[1]*f->w_lp[1]);
        f->norm_now = norm;

        if ((norm > 1.0e-3f) && (f->ref_norm > 1.0e-3f))
        {
            float sig_lp = f->sigma / sqrtf((float)f->wring_n);
            dip   = atan2f(f->w_lp[2], horiz);
            alpha = atan2f(f->w_lp[1], f->w_lp[0]);
            f->dip_now = dip;

            /* ---- the joint alignment / field / offset estimator ---- */
            mf_fe_service(f, q, dt);

            /* ---- gate 1: magnitude ---- */
            {
                float tol = mf_maxf(MAG_NORM_TOL * f->ref_norm,
                                    MAG_NORM_SIGMA * sig_lp)
                          + mf_cal_gate_pad(f) * f->ref_norm;
                f->e_norm = fabsf(norm - f->ref_norm) / tol;
            }

            /* ---- gate 2: dip.  Held off until the field estimator has
             * actually resolved the dip, because before that the reference
             * is only as good as whatever pose the board started in. ---- */
            if (f->ref_dip_valid)
            {
                float tol = mf_maxf(MAG_DIP_TOL_RAD, MAG_DIP_SIGMA * sig_lp)
                          + mf_cal_gate_pad(f);
                f->e_dip = fabsf(mf_wrap_pi(dip - f->ref_dip)) / tol;
            }
            else f->e_dip = 0.0f;

            /* ---- gate 3: fast world-frame step ----
             * |w - w_filtered| catches a sudden change in one sample.  It
             * replaces rev 1's sample-to-sample derivative, which is the
             * worst possible statistic in the presence of a near-Nyquist
             * interferer because differencing DOUBLES it. */
            {
                float dx = f->w_now[0] - f->w_lp[0];
                float dy = f->w_now[1] - f->w_lp[1];
                float dz = f->w_now[2] - f->w_lp[2];
                float tol = mf_maxf(MAG_STEP_FLOOR, MAG_STEP_SIGMA * f->sigma)
                          + MAG_STEP_OMEGA_K * omega + mf_cal_gate_pad(f);
                f->e_step = sqrtf(dx*dx + dy*dy + dz*dz) / tol;
            }

            /* ---- gate 4: slow windowed drift of the filtered vector ----
             * The world vector must not move at all.  Averaged over a
             * window it is quiet enough to catch a magnet creeping in far
             * below the level the magnitude and dip gates can see. */
            if (!f->anchor_valid)
            {
                memcpy(f->w_anchor, f->w_lp, sizeof(f->w_anchor));
                f->anchor_valid = 1u;
                f->anchor_s = 0.0f;
                f->e_drift = 0.0f;
            }
            else
            {
                f->anchor_s += dt;
                if (f->anchor_s >= MAG_DRIFT_WINDOW_S)
                {
                    float na = sqrtf(f->w_anchor[0]*f->w_anchor[0] +
                                     f->w_anchor[1]*f->w_anchor[1] +
                                     f->w_anchor[2]*f->w_anchor[2]);
                    float dot = (f->w_lp[0]*f->w_anchor[0] +
                                 f->w_lp[1]*f->w_anchor[1] +
                                 f->w_lp[2]*f->w_anchor[2]);
                    float ang, tol;
                    f->anchor_s = 0.0f;
                    if ((na > 1.0e-6f) && (norm > 1.0e-6f))
                        dot /= (na * norm);
                    else dot = 1.0f;
                    ang = acosf(mf_clampf(dot, -1.0f, 1.0f));
                    tol = mf_maxf(MAG_DRIFT_FLOOR_RAD, MAG_DRIFT_SIGMA * sig_lp)
                        + MAG_DRIFT_OMEGA_K * omega + mf_cal_gate_pad(f);
                    if (ang > tol)
                    {
                        if (f->drift_run < 0xFFFFFFFFu) f->drift_run++;
                        if (f->drift_run >= MAG_DRIFT_RUN)
                        {
                            f->e_drift   = ang / tol;
                            f->diag_hold = MAG_DIAG_HOLD;
                        }
                    }
                    else
                    {
                        f->drift_run = 0u;
                        f->e_drift   = 0.0f;
                        memcpy(f->w_anchor, f->w_lp, sizeof(f->w_anchor));
                    }
                }
            }

            /* ---- gate 6: the rest of the hand ---- */
            f->e_fleet = 0.0f;
            {
                float fn, fd;
                mf_fleet_publish(f, norm, dip);
                if (mf_fleet_consensus(f, &fn, &fd))
                {
                    float ed = fabsf(mf_wrap_pi(dip - fd)) / MAG_FLEET_DIP_TOL;
                    float en = fabsf(norm - fn) / mf_maxf(fn * MAG_FLEET_NORM_TOL, 1.0e-3f);
                    f->e_fleet = mf_maxf(ed, en);
                    /* A link with no dip reference of its own can adopt the
                     * hand's immediately - twenty links see one earth field. */
                    if (!f->ref_dip_valid)
                    {
                        f->ref_dip = f->ref_dip0 = fd;
                        f->ref_norm = f->ref_norm0 = fn;
                        f->ref_dip_valid = 1u;
                    }
                }
            }

            /* ---- combine ---- */
            e = f->e_norm;
            if (f->e_dip   > e) e = f->e_dip;
            if (f->e_step  > e) e = f->e_step;
            if (f->e_drift > e) e = f->e_drift;
            if (f->e_grad  > e) e = f->e_grad;
            if (f->e_fleet > e) e = f->e_fleet;
            if (horiz < MAG_HORIZ_MIN * f->ref_norm) e = MAG_EVENT_ENTER + 1.0f;
            f->e_inst = e;

            /*
             * The weight and the event machine run off a LOW-PASSED error.
             * Rev 1 used the per-sample value, so one noisy sample dropped
             * the lock and reset every "consecutive clean samples" counter
             * in the module - which is why the drift estimator, the safe
             * snapshot and the gradient learner, all of which demanded long
             * unbroken runs, effectively never armed on real hardware.
             */
            {
                float k = mf_clampf(dt / MAG_E_TAU_S, 0.0f, 1.0f);
                f->e_lp += k * (e - f->e_lp);
            }
            e = (f->e_inst >= MAG_E_INSTANT) ? f->e_inst : f->e_lp;

            e_event = e;
            if (f->motion_hold_s < MAG_MOTION_GUARD_HOLD_S)
            {
                e_event = f->e_norm;
                if (f->e_dip   > e_event) e_event = f->e_dip;
                if (f->e_grad  > e_event) e_event = f->e_grad;
                if (f->e_fleet > e_event) e_event = f->e_fleet;
            }

            mf_ref_update(f, norm, dip, dt, e);

            /* ---- disturbance event machine ---- */
            if ((e_event >= MAG_EVENT_ENTER) && !f->hard_event)
            {
                f->hard_event = 1u;
                if (f->fe.field_valid)
                {
                    memcpy(f->safe_B, f->fe.B, sizeof(f->safe_B));
                    f->safe_B_valid = 1u;
                }
                /* Discard stale pre-event attitude/field pairs.  They may
                 * still describe the old unmagnetised board and otherwise make
                 * the post-event solve look observable before the new d exists. */
                mf_fe_reset(&f->fe);
                f->fe.field_valid = 0u;
                memset(f->fe.B, 0, sizeof(f->fe.B));
                memset(f->fe.d, 0, sizeof(f->fe.d));
                if (!f->safe_valid)
                {
                    f->safe_norm  = f->ref_norm;
                    f->safe_dip   = f->ref_dip;
                    f->safe_valid = 1u;
                }
                if (!f->safe_yaw_valid)
                {
                    f->safe_yaw_corr  = f->yaw_corr;
                    f->safe_yaw_valid = f->yaw_valid;
                    f->safe_datum     = f->mag_datum_offset;
                }
                if (f->safe_yaw_valid)
                {
                    f->yaw_corr         = f->safe_yaw_corr;
                    f->mag_datum_offset = f->safe_datum;
                    f->yaw_valid        = 1u;
                }
                f->coast_acc  = 0.0f;
                f->cand_valid = 0u; f->cand_s = 0.0f; f->good_s = 0.0f;
            }

            if (e <= 1.0f) { w = 1.0f; f->good_s += dt; }
            else
            {
                f->good_s = 0.0f;
                if (e < MAG_REJECT_AT)
                {
                    float t = (MAG_REJECT_AT - e) / (MAG_REJECT_AT - 1.0f);
                    w = t * t;              /* Huber-ish soft derating */
                }
                else w = 0.0f;
            }

            if (f->hard_event)
            {
                uint8_t shape_ok =
                    (f->e_norm <= 1.0f) && (f->e_dip <= 1.0f) &&
                    (f->e_grad <= 1.0f) && (f->e_step <= 1.0f);

                if ((e <= 1.0f) && (f->good_s >= MAG_RECOVER_S))
                {
                    if (f->safe_valid)
                    {
                        f->ref_norm = f->safe_norm;
                        f->ref_dip  = f->safe_dip;
                        f->ref_dip_valid = 1u;
                    }
                    if (f->safe_yaw_valid)
                    {
                        f->yaw_corr  = f->safe_yaw_corr;
                        f->yaw_valid = 1u;
                        f->mag_datum_offset = f->safe_datum;
                    }
                    f->hard_event = 0u; f->rejecting = 0u;
                    f->cand_valid = 0u; f->cand_s = 0.0f;
                    f->anchor_valid = 0u; f->drift_run = 0u; f->e_drift = 0.0f;
                    w = 1.0f;
                }
                else if ((f->motion_hold_s >= MAG_MOTION_GUARD_HOLD_S) &&
                         ((e <= MAG_REBASE_ERR_MAX) || shape_ok) &&
                         (dual || (f->fe.field_valid &&
                                   (f->fe.n >= MAG_FE_MIN_N) &&
                                   (f->fe.obs <= MAG_FE_OBS_MAX) &&
                                   (f->fe.res <= MAG_FE_RES_MAX))))
                {
                    /* A stable field of the right shape may be a genuine new
                     * environment.  With two parts that agree the field is
                     * spatially uniform, so there is no nearby source and it
                     * can be adopted in a second instead of four. */
                    float need = (dual && (f->grad_n >= MAG_GRAD_WARMUP) &&
                                  (f->e_grad <= 1.0f))
                               ? MAG_REBASE_DUAL_S : MAG_REBASE_S;

                    if (!f->cand_valid)
                    {
                        f->cand_norm = norm; f->cand_dip = dip;
                        f->cand_s = 0.0f; f->cand_valid = 1u;
                    }
                    else
                    {
                        float cn = fabsf(norm - f->cand_norm) /
                                   (f->cand_norm * MAG_NORM_TOL);
                        float cd = fabsf(mf_wrap_pi(dip - f->cand_dip)) /
                                   MAG_DIP_TOL_RAD;
                        if ((cn <= MAG_REBASE_CAND_TOL) && (cd <= MAG_REBASE_CAND_TOL))
                            f->cand_s += dt;
                        else
                        { f->cand_norm = norm; f->cand_dip = dip; f->cand_s = 0.0f; }
                    }

                    if (f->cand_s >= need)
                    {
                        f->ref_norm = f->ref_norm0 = f->cand_norm;
                        f->ref_dip  = f->ref_dip0  = f->cand_dip;
                        f->ref_dip_valid = 1u;
                        f->hard_event = 0u; f->rejecting = 0u;
                        f->cand_valid = 0u; f->cand_s = 0.0f;
                        f->head_rebase_s = 0.0f;
                        f->anchor_valid = 0u; f->drift_run = 0u; f->e_drift = 0.0f;
                        f->good_s = 0.0f;
                        {
                            float traw = mf_wrap_pi(-alpha +
                                (MAG_DECLINATION_DEG + MAG_YAW_DATUM_DEG) * MF_DEG2RAD);
                            if (f->yaw_valid)
                                f->mag_datum_offset = mf_wrap_pi(traw - f->yaw_corr);
                            else
                            { f->yaw_corr = traw; f->mag_datum_offset = 0.0f; }
                            f->yaw_valid = 1u;
                        }
                        w = 1.0f;
                    }
                    else { w = 0.0f; f->rejecting = 1u; }
                }
                else { f->cand_valid = 0u; f->cand_s = 0.0f; f->rejecting = 1u; w = 0.0f; }
            }
            else if (w <= 0.0f) f->rejecting = 1u;
            else if (f->rejecting && (e <= 1.0f) && (f->good_s >= MAG_RECOVER_S))
                f->rejecting = 0u;
            else if (f->rejecting) w = 0.0f;

            /* Unified recovery: once every physical gate has been clean for the
             * recovery interval, no state-machine branch is allowed to keep the
             * link rejected.  This closes the candidate/rebase path that could
             * otherwise stay rejecting after e already fell back below 1. */
            if ((f->good_s >= MAG_RECOVER_S) &&
                (f->e_norm <= 1.0f) && (f->e_dip <= 1.0f) &&
                (f->e_step <= 1.0f) && (f->e_drift <= 1.0f) &&
                (f->e_grad <= 1.0f) && (f->e_fleet <= 1.0f))
            {
                f->hard_event = 0u;
                f->rejecting  = 0u;
                f->cand_valid = 0u;
                f->cand_s     = 0.0f;
                w = 1.0f;
            }

            f->weight = w;

            if (!f->hard_event && (e <= MAG_SAFE_MAX_ERR) && f->yaw_valid && (w >= 0.99f))
            {
                f->safe_valid = 1u;
                f->safe_norm  = f->ref_norm;
                f->safe_dip   = f->ref_dip;
                f->safe_yaw_corr  = f->yaw_corr;
                f->safe_yaw_valid = 1u;
                f->safe_datum = f->mag_datum_offset;
            }

            /*
             * Gradient noise floor.
             *
             * The learning window is gated by the OTHER detectors only.  Rev 1
             * gated it on e, which contains e_grad, so the learner only ever
             * saw samples below half its own threshold: a censored sample set
             * whose mean and spread are both biased low, which drove the
             * threshold down, which censored harder.  The fixed point sat
             * right on top of the operating point, so e_grad was pinned near
             * the edge and any ripple dropped the lock.
             */
            if (dual && !f->hard_event && (f->grad_now < MAG_GRAD_CEIL) &&
                (f->e_norm <= 1.0f) && (f->e_dip <= 1.0f) &&
                (f->e_step <= 1.0f) && (f->e_drift <= 1.0f) && (f->e_fleet <= 1.0f))
            {
                float kg = (f->grad_now < f->grad_mu) ? MAG_GRAD_FALL : MAG_GRAD_RISE;
                float dv;
                float floor_res;
                f->grad_mu  += kg * (f->grad_now - f->grad_mu);
                dv = f->grad_now - f->grad_mu;
                if (dv < 0.0f) dv = 0.0f;
                f->grad_var += kg * (dv*dv - f->grad_var);
                /* Never tighter than what the map can actually achieve, or
                 * than the measurement noise of the pair. */
                floor_res = mf_maxf(MAG_GRAD_FLOOR,
                                    mf_maxf(MAG_GRAD_RES_K * f->map_res,
                                            MAG_GRAD_SIGMA * 1.414f * f->sigma));
                f->grad_thr = mf_clampf(f->grad_mu + MAG_GRAD_SIGMA * sqrtf(f->grad_var),
                                        floor_res, MAG_GRAD_CEIL);
                if (f->grad_n < 0xFFFFFFFFu) f->grad_n++;
            }

            /* ---- residual yaw-drift estimator ----
             * While the magnetometer is trusted, yaw_corr moves at exactly
             * the residual yaw drift rate of the 6-axis solution.  The window
             * only has to be clean ON AVERAGE; rev 1 required 500 consecutive
             * flawless samples, which never happened, so the coast
             * compensation never armed. */
            if (f->yaw_valid && (omega < MAG_COAST_OMEGA_MAX) && !f->hard_event)
            {
                if (!f->drift_anchored)
                {
                    f->drift_anchor   = f->yaw_corr;
                    f->drift_acc_s    = 0.0f;
                    f->drift_bad_s    = 0.0f;
                    f->drift_anchored = 1u;
                }
                else
                {
                    f->drift_acc_s += dt;
                    if (w < 0.5f) f->drift_bad_s += dt;
                    if (f->drift_acc_s >= MAG_COAST_WIN_S)
                    {
                        if (f->drift_bad_s <= MAG_COAST_BAD_FRAC * f->drift_acc_s)
                        {
                            float rate = mf_wrap_pi(f->yaw_corr - f->drift_anchor) /
                                         f->drift_acc_s;
                            float kd = f->drift_acc_s / MAG_COAST_TAU_S;
                            if (kd > 0.5f) kd = 0.5f;
                            rate = mf_clampf(rate, -MAG_COAST_MAX_RAD_S,
                                             MAG_COAST_MAX_RAD_S);
                            f->drift_rate += kd * (rate - f->drift_rate);
                            if (f->drift_n < MAG_COAST_WARMUP) f->drift_n++;
                            else f->drift_valid = 1u;
                        }
                        f->drift_anchor = f->yaw_corr;
                        f->drift_acc_s  = 0.0f;
                        f->drift_bad_s  = 0.0f;
                    }
                }
            }
            else f->drift_anchored = 0u;

            /* ---- heading measurement ---- */
            {
                float traw = mf_wrap_pi(-alpha +
                        (MAG_DECLINATION_DEG + MAG_YAW_DATUM_DEG) * MF_DEG2RAD);
                if (f->cal_commit_pending)
                {
                    if (f->yaw_valid)
                        f->mag_datum_offset = mf_wrap_pi(traw - f->yaw_corr);
                    else
                        f->mag_datum_offset = 0.0f;
                    f->cal_commit_pending = 0u;
                }
                target = mf_wrap_pi(traw - f->mag_datum_offset);
            }

            /* ---- 1-D Kalman update on the yaw correction ----
             * The gain is derived from the measured magnetometer noise and
             * the 6-axis drift rate instead of a hand-picked time constant.
             * Rev 1 used tau = 20 ms, i.e. k = 0.5 per sample at 100 Hz, so
             * magnetometer noise went almost straight into the output yaw. */
            f->yaw_P = mf_clampf(f->yaw_P + MAG_YAW_Q * dt, 0.0f, MAG_YAW_P_MAX);

            if ((w > 0.0f) && !f->yaw_blend_valid)
            {
                if (!f->yaw_valid)
                {
                    f->yaw_corr = target;
                    f->mag_datum_offset = 0.0f;
                    f->yaw_valid = 1;
                    f->yaw_P = MAG_YAW_P0;
                }
                else
                {
                    float innov = mf_wrap_pi(target - f->yaw_corr);
                    float hz = mf_maxf(horiz, 0.05f);
                    float sh = sig_lp / hz;
                    float R  = mf_maxf(MAG_YAW_R_MIN, sh * sh);
                    float S, nis;

                    R *= (1.0f + omega / MAG_OMEGA_DERATE);   /* sample skew */
                    R /= mf_clampf(w, 1.0e-3f, 1.0f);         /* soft derate */
                    S = f->yaw_P + R;
                    nis = (S > 1.0e-12f) ? (innov * innov / S) : 0.0f;

                    if ((nis > MAG_YAW_NIS_MAX) || (fabsf(innov) > MAG_YAW_INNOV_MAX))
                    {
                        /* A persistent, well-shaped heading offset is a new
                         * magnetic datum, not a one-shot outlier. */
                        uint8_t magnetic_shape_ok =
                            (!f->hard_event) &&
                            (f->e_norm <= 1.0f) && (f->e_dip <= 1.0f) &&
                            (f->e_grad <= 1.0f) && (f->e_step <= 1.0f) &&
                            (f->e_fleet <= 1.0f);

                        if (f->motion_recover_armed &&
                            (f->motion_hold_s >= MAG_MOTION_GUARD_HOLD_S) &&
                            magnetic_shape_ok)
                        {
                            float lim = MAG_MOTION_RECOVER_RAD_S * dt;
                            float step = mf_clampf(innov, -lim, lim);
                            f->yaw_corr = mf_wrap_pi(f->yaw_corr + step);
                            f->yaw_P = mf_clampf(f->yaw_P + MAG_YAW_Q * dt,
                                                 0.0f, MAG_YAW_P_MAX);
                            f->head_rebase_s = 0.0f;
                            f->recovery_good_s = 0.0f;
                        }
                        else if (!f->motion_recover_armed && magnetic_shape_ok)
                        {
                            f->head_rebase_s += dt;
                            if (f->head_rebase_s >= MAG_HEAD_REBASE_S)
                            {
                                f->mag_datum_offset =
                                    mf_wrap_pi(mf_wrap_pi(-alpha +
                                        (MAG_DECLINATION_DEG + MAG_YAW_DATUM_DEG) * MF_DEG2RAD)
                                        - f->yaw_corr);
                                f->yaw_valid = 1u;
                                f->head_rebase_s = 0.0f;
                                f->rejecting = 0u;
                                f->anchor_valid = 0u;
                                f->drift_run = 0u;
                                f->e_drift = 0.0f;
                            }
                            else { f->weight = 0.0f; f->rejecting = 1u; }
                        }
                        else
                        {
                            f->head_rebase_s = 0.0f;
                            f->weight = 0.0f;
                            f->rejecting = 1u;
                        }
                    }
                    else
                    {
                        float K = f->yaw_P / S;
                        f->head_rebase_s = 0.0f;
                        f->yaw_corr = mf_wrap_pi(f->yaw_corr + K * innov);
                        f->yaw_P    = (1.0f - K) * f->yaw_P;

                        if (f->motion_recover_armed)
                        {
                            if ((fabsf(innov) <= MAG_YAW_INNOV_MAX) &&
                                (f->e_norm <= 1.0f) && (f->e_dip <= 1.0f) &&
                                (f->e_grad <= 1.0f) && (f->e_step <= 1.0f) &&
                                (f->e_fleet <= 1.0f))
                                f->recovery_good_s += dt;
                            else
                                f->recovery_good_s = 0.0f;

                            if (f->recovery_good_s >= MAG_MOTION_RECOVER_GOOD_S)
                            {
                                f->motion_recover_armed = 0u;
                                f->recovery_good_s = 0.0f;
                            }
                        }
                    }
                }
            }
        }
        else f->weight = 0.0f;
    }
    else
    {
        f->stale_s += dt;
        if (f->stale_s > MAG_STALE_S) f->weight = 0.0f;
    }

    if (f->diag_hold > 0u) f->diag_hold--;

    /* ---- last-resort recovery ----
     * The field estimator normally absorbs a magnetised board during ordinary
     * motion and this never fires.  It exists so that "stuck for ever" is not
     * a reachable state. */
    if (f->weight > 0.0f) f->stuck_s = 0.0f;
    else
    {
        f->stuck_s += dt;
        if (f->stuck_s > MAG_STUCK_RECAL_S)
        {
            /* Never throw away a valid ellipsoid fit just because the gates
             * stayed pessimistic.  Losing calibration guarantees the host
             * falls back to NO_CAL/dip-invalid; reset only the magnetic datum
             * and let acquisition try again. */
            mag_fusion_rebase_runtime(f);
            f->stuck_s = 0.0f;
        }
    }

    /* ---- coasting ---- */
    if (f->weight > 0.0f) f->coast_acc = 0.0f;
    else if (f->yaw_valid && f->drift_valid && !f->hard_event && !f->rejecting &&
             (f->diag_hold == 0u))
    {
        float step = f->drift_rate * dt;
        if (fabsf(f->coast_acc + step) <= MAG_COAST_MAX_RAD)
        {
            f->yaw_corr   = mf_wrap_pi(f->yaw_corr + step);
            f->coast_acc += step;
        }
    }

    /*
     * Stabilise the 6-AXIS attitude first, then apply the yaw correction.
     * The other order low-passes the correction with the stabiliser's time
     * constant, which is exactly how rev 1 hid its own recovery.
     */
    mf_stabilize_attitude(f, q, dt);

    if (f->yaw_valid)
    {
        mf_apply_yaw_correction(f, q);
        if      (f->weight <= 0.0f)  f->status = MAG_ST_COASTING;
        else if (f->weight >= 0.95f) f->status = MAG_ST_LOCKED;
        else                         f->status = MAG_ST_DEGRADED;
    }
    else f->status = MAG_ST_ACQUIRING;

    /* Final output guard.  If every physical gate is clean and the calibration
     * and dip are valid, stale event-machine flags must not keep the host in
     * COASTING or light bit6.  Treat only e > 1 as dirty so a transient NaN in
     * an unused fallback gate cannot block recovery. */
    if (f->cal[0].valid && f->ref_dip_valid &&
        !(f->e_norm  > 1.0f) && !(f->e_dip   > 1.0f) &&
        !(f->e_step  > 1.0f) && !(f->e_drift > 1.0f) &&
        !(f->e_grad  > 1.0f) && !(f->e_fleet > 1.0f))
    {
        f->hard_event = 0u;
        f->rejecting  = 0u;
        f->cand_valid = 0u;
        f->cand_s     = 0.0f;
        f->diag_hold  = 0u;
        f->weight     = 1.0f;
        f->status     = MAG_ST_LOCKED;
    }

    return f->status;
}

/* ======================================================================== */
/*  Reporting and persistence                                               */
/* ======================================================================== */

float mag_fusion_stuck_seconds(const mag_fusion_t *f) { return f->stuck_s; }
float mag_fusion_sigma(const mag_fusion_t *f)         { return f->sigma; }
uint16_t mag_fusion_fixes(const mag_fusion_t *f)      { return f->fe.fixes; }

float mag_fusion_align_deg(const mag_fusion_t *f)
{
    return mf_m3_angle(f->A) * (180.0f / MF_PI);
}

float mag_fusion_accuracy(const mag_fusion_t *f)
{
    float w = mf_clampf(f->weight, 0.0f, 1.0f);
    uint8_t cal_result = (uint8_t)(f->cal[0].result % 10u);
    uint8_t diag = 0u;

    if (f->cal[0].valid) cal_result = MAG_CAL_OK;

    if (!f->cal[0].valid)                              diag |= 0x01u;
    if (!f->ref_dip_valid)                             diag |= 0x02u;
    if (f->e_norm  >= 1.0f)                            diag |= 0x04u;
    if (f->e_dip   >= 1.0f)                            diag |= 0x08u;
    if (f->e_step  >= 1.0f)                            diag |= 0x10u;
    if (f->e_grad  >= 1.0f)                            diag |= 0x20u;
    if ((f->e_drift >= 1.0f) || (f->diag_hold > 0u))   diag |= 0x40u;
    if (f->hard_event || f->cand_valid)                diag |= 0x80u;
    if ((f->rejecting || (f->weight <= 0.0f)) && diag == 0u) diag = 0x40u;

    return (float)f->status + 10.0f * (float)cal_result
         + 100.0f * (float)diag + 0.99f * w;
}

uint8_t mag_fusion_save(const mag_fusion_t *f, mag_cal_blob_t *blob)
{
    uint8_t s, i;

    if (!f->cal[0].valid) return 0;

    memset(blob, 0, sizeof(*blob));
    blob->version = MAG_CAL_BLOB_VERSION;
    blob->flags   = MAG_BLOB_F_CAL1;

    for (s = 0; s < 2u; s++)
    {
        for (i = 0; i < 3; i++) blob->offset[s][i] = f->cal[s].offset[i];
        memcpy(blob->W[s], f->cal[s].W, sizeof(blob->W[s]));
        blob->radius[s] = f->cal[s].radius;
    }
    if (f->cal[1].valid)     blob->flags |= MAG_BLOB_F_CAL2;
    if (f->map_valid)        blob->flags |= MAG_BLOB_F_MAP;
    if (f->ref_dip_valid)    blob->flags |= MAG_BLOB_F_DIP;
    if (f->fe.align_valid)   blob->flags |= MAG_BLOB_F_ALIGN;

    memcpy(blob->map,   f->map,   sizeof(blob->map));
    memcpy(blob->map_c, f->map_c, sizeof(blob->map_c));
    memcpy(blob->align, f->A,     sizeof(blob->align));
    blob->dip = f->ref_dip;
    return 1;
}

uint8_t mag_fusion_load(mag_fusion_t *f, const mag_cal_blob_t *blob)
{
    uint8_t had_yaw = f->yaw_valid;
    uint8_t have_good_yaw = f->safe_yaw_valid;
    float current_yaw = f->yaw_corr;
    float good_yaw = f->safe_yaw_corr;

    uint8_t s, i;

    if (blob->version != MAG_CAL_BLOB_VERSION) return 0;
    if (!(blob->flags & MAG_BLOB_F_CAL1)) return 0;

    /* An explicit calibration load is a deliberate datum change, not a
     * dynamic-motion artifact.  Do not let the post-motion recovery guard
     * reinterpret it as a stale yaw error. */
    f->motion_hold_s = MAG_MOTION_GUARD_HOLD_S;
    f->motion_recover_armed = 0u;
    f->recovery_good_s = 0.0f;
    if (!(blob->radius[0] > 0.0f) || !isfinite(blob->radius[0])) return 0;

    for (s = 0; s < 2u; s++)
    {
        for (i = 0; i < 3; i++) f->cal[s].offset[i] = blob->offset[s][i];
        memcpy(f->cal[s].W, blob->W[s], sizeof(f->cal[s].W));
        f->cal[s].radius  = blob->radius[s];
        f->cal[s].quality = 1.0e9f;
        f->cal[s].geo_q   = 1.0e9f;
        mf_cal_zero(&f->cal[s]);
        f->cal[s].model  = (blob->flags & MAG_BLOB_F_MODEL_FULL) ? 2u :
                           ((blob->flags & MAG_BLOB_F_MODEL_DIAG) ? 1u : 0u);
        f->cal[s].active = 0;
        f->cal[s].valid  = 0;
        f->cal[s].result = MAG_CAL_OK;
        f->cal[s].revision = 1u;
    }

    f->cal[0].valid = 1;
    if ((blob->flags & MAG_BLOB_F_CAL2) && (blob->radius[1] > 0.0f))
        f->cal[1].valid = 1;
#if MAG_CAL_AUTO
    else
        f->cal[1].active = 2u;
#endif
    /* Loaded calibration is the immutable last-good base.  Only an explicit
     * H sweep may create a new base; ordinary runtime motion may update the
     * dynamic body offset, but must never silently replace W/A/radius. */
    f->cal[0].active = 0u;
    if (f->cal[1].valid) f->cal[1].active = 0u;

    if (blob->flags & MAG_BLOB_F_MAP)
    {
        memcpy(f->map,   blob->map,   sizeof(f->map));
        memcpy(f->map_c, blob->map_c, sizeof(f->map_c));
        f->map_valid = 1;
        f->map_res   = MAG_GRAD_FLOOR;
    }
    else { mf_map_reset(f); mf_m3_identity(f->map); f->map_valid = 0; }

    if (blob->flags & MAG_BLOB_F_ALIGN)
    {
        memcpy(f->A, blob->align, sizeof(f->A));
        f->fe.align_valid = 1;
    }
    else
    {
        mf_m3_identity(f->A);
        f->fe.align_valid = 1u;   /* identity is the valid default mounting map */
    }

    mf_fe_reset(&f->fe);
    mf_partial_reset(f);
    f->cal_commit_pending = 1u;

    if (blob->flags & MAG_BLOB_F_DIP)
    {
        f->ref_dip       = blob->dip;
        f->ref_dip0      = blob->dip;
        f->ref_dip_valid = 1;
    }

    if (have_good_yaw)
    {
        f->yaw_corr  = good_yaw;
        f->yaw_valid = 1u;
        if (had_yaw)
        {
            float d = current_yaw - good_yaw;
            f->yaw_blend = atan2f(sinf(d), cosf(d));
            f->yaw_blend_valid = (uint8_t)(fabsf(f->yaw_blend) > 1.0e-4f);
        }
        else
        {
            f->yaw_blend = 0.0f;
            f->yaw_blend_valid = 0u;
        }
    }
    return 1;
}